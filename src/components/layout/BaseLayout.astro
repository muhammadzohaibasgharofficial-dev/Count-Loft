---
/**
 * Count Loft — Base Layout Component
 * Root HTML shell managing metadata, theme initialization, navigation landmarks, and global styling.
 */
import '../../styles/global.css';
import '../../selene/selene.css';
import '../../styles/print.css';

import SEOHead from '@components/seo/SEOHead.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import Toast from '@components/ui/Toast.astro';
import { CLOUDFLARE_WA_TOKEN, analyticsEnabled } from '@lib/seo/analytics';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  robots?: string;
  ogType?: 'website' | 'article';
}

const isHome = Astro.url.pathname === '/';

const {
  title,
  description,
  canonicalUrl,
  robots,
  ogType
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Monetag ad tag (zone 306282) — site-wide; embed pages use EmbedLayout and stay ad-free -->
    <script src="https://quge5.com/88/tag.min.js" data-zone="306282" async data-cfasync="false"></script>

    <meta name="theme-color" content="#FAF7F1" />
    <!-- SELENE type system: Michroma (display), Manrope (text), IBM Plex Mono (telemetry). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Michroma&family=Manrope:wght@300..700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
    <SEOHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      robots={robots}
      ogType={ogType}
    />

    <!-- The site has one theme (cream). Set it before first paint so there is no flash. -->
    <script is:inline>
      document.documentElement.setAttribute('data-theme', 'light');
      document.documentElement.style.colorScheme = 'light';
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <slot name="before-header" />
    <Header />
    <main id="main" style={isHome ? undefined : 'padding-top: 4.75rem'}>
      <slot />
    </main>
    <Footer />
    <Toast />
    {analyticsEnabled && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: CLOUDFLARE_WA_TOKEN })}
      ></script>
    )}
  </body>
</html>
