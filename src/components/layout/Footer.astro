---
/**
 * Count Loft — Site Footer Component
 * Includes 7 category sections, 5 trust/compliance links, privacy promise, and copyright.
 */

const categories = [
  { label: 'Finance', href: '/finance' },
  { label: 'Health', href: '/health' },
  { label: 'Math', href: '/math' },
  { label: 'Construction', href: '/construction' },
  { label: 'Converters', href: '/converters' },
  { label: 'Pakistan', href: '/pakistan' },
  { label: 'Islamic', href: '/islamic' }
];

const trustLinks = [
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms of Service', href: '/terms' },
  { label: 'Corrections', href: '/corrections' }
];

const toolLinks = [
  { label: 'All Tools', href: '/#all-tools' },
  { label: 'Calculators', href: '/calculators' },
  { label: 'About the Calculators', href: '/calculators/about' },
  { label: 'How to Use', href: '/calculators/how-to-use' },
  { label: 'Search', href: '/search' }
];

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Column 1: Brand & Privacy Pledge -->
      <div class="footer-col footer-brand-col">
        <span class="footer-brand">Count Loft</span>
        <p class="footer-tagline">
          A home for free online tools. Calculators today, more tool families on the way. No sign-up, no tracking of what you type.
        </p>
        <div class="privacy-pledge">
          <svg class="privacy-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span class="pledge-text">Your numbers never leave your browser.</span>
        </div>
      </div>

      <!-- Column 2: Tools (families) -->
      <div class="footer-col">
        <p class="footer-heading">Tools</p>
        <ul class="footer-list">
          {toolLinks.map((item) => (
            <li><a href={item.href} class="footer-link">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Calculator Categories -->
      <div class="footer-col">
        <p class="footer-heading">Categories</p>
        <ul class="footer-list">
          {categories.map((cat) => (
            <li>
              <a href={cat.href} class="footer-link">{cat.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Trust & Legal Pages -->
      <div class="footer-col">
        <p class="footer-heading">Trust & Legal</p>
        <ul class="footer-list">
          {trustLinks.map((item) => (
            <li>
              <a href={item.href} class="footer-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} Count Loft. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    margin-top: 0;
    padding-top: var(--space-7);
    padding-bottom: var(--space-6);
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: var(--space-6);
    }
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .footer-tagline {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    max-width: 40ch;
  }

  .privacy-pledge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
  }

  .privacy-icon {
    color: var(--color-secondary);
    flex-shrink: 0;
  }

  .pledge-text {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
  }

  .footer-heading {
    font-size: var(--text-label);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-link {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--color-link);
    text-decoration: underline;
  }

  .footer-bottom {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .copyright {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
