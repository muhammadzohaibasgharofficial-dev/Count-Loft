---
/**
 * Count Loft — Category Hub Component
 * Reusable directory view listing all calculators in a given category with tool counts and breadcrumbs.
 */
import BaseLayout from '@components/layout/BaseLayout.astro';
import Breadcrumbs from '@components/seo/Breadcrumbs.astro';
import { buildBreadcrumbs } from '@lib/format/breadcrumbs';
import type { CalculatorMeta } from '@data/calculators';

export interface Props {
  categoryName: string;
  categorySlug: string;
  description: string;
  tools: CalculatorMeta[];
}

const {
  categoryName,
  categorySlug,
  description,
  tools
} = Astro.props;

const breadcrumbs = buildBreadcrumbs([
  { label: categoryName, href: `/${categorySlug}` }
]);
---

<BaseLayout
  title={`${categoryName} Calculators — Free Tools | Count Loft`}
  description={`Explore our collection of ${tools.length} free, fast, and accessible ${categoryName.toLowerCase()} calculators. ${description}`}
>
  <div class="container category-hub-container">
    <Breadcrumbs items={breadcrumbs} />

    <header class="category-header">
      <div class="category-badge-row">
        <span class="category-pill">{categoryName}</span>
        <span class="tools-count">{tools.length} Calculators</span>
      </div>
      <h1>{categoryName} Calculators</h1>
      <p class="category-lead">{description}</p>
    </header>

    <div class="tools-directory-grid">
      {tools.map((tool) => (
        <a href={tool.href} class="card tool-card">
          <div class="tool-card-content">
            <h2 class="tool-card-title">{tool.name}</h2>
            <p class="tool-card-desc">{tool.description}</p>
          </div>
          <div class="tool-card-footer">
            <span class="open-tool-label">Use Calculator</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .category-hub-container {
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
  }

  .category-header {
    margin-bottom: var(--space-7);
  }

  .category-badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .category-pill {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
  }

  .tools-count {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .category-lead {
    font-size: var(--text-h3);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
    max-width: var(--article-max-width);
  }

  .tools-directory-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 640px) {
    .tools-directory-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tools-directory-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-5);
    text-decoration: none;
    color: var(--color-text);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .tool-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .tool-card-title {
    font-size: 1.125rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    margin: 0 0 var(--space-2) 0;
  }

  .tool-card:hover .tool-card-title {
    color: var(--color-link);
  }

  .tool-card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .tool-card-footer {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-link);
  }
</style>
