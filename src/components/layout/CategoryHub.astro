---
/**
 * Count Loft — Category Hub Component
 * Reusable directory view listing all calculators in a given category with tool counts and breadcrumbs.
 */
import BaseLayout from '@components/layout/BaseLayout.astro';
import Breadcrumbs from '@components/seo/Breadcrumbs.astro';
import { buildBreadcrumbs } from '@lib/format/breadcrumbs';
import Icon from '@components/ui/Icon.astro';
import { CATEGORIES_CONFIG } from '@data/calculators';
import type { CalculatorMeta } from '@data/calculators';

export interface Props {
  categoryName: string;
  categorySlug: string;
  description: string;
  tools: CalculatorMeta[];
}

const {
  categoryName,
  categorySlug,
  description,
  tools
} = Astro.props;

const siblings = CATEGORIES_CONFIG;
const breadcrumbs = buildBreadcrumbs([
  { label: categoryName, href: `/${categorySlug}` }
]);
---

<BaseLayout
  title={`${categoryName} Calculators — Free Tools | Count Loft`}
  description={`Explore our collection of ${tools.length} free, fast, and accessible ${categoryName.toLowerCase()} calculators. ${description}`}
>
  <div class="container category-hub-container">
    <Breadcrumbs items={breadcrumbs} />

    <header class="category-header">
      <div class="category-badge-row">
        <span class={`mark tint-${categorySlug}`}><Icon name={categorySlug} size={26} /></span>
        <span class="tools-count">{tools.length} Calculators</span>
      </div>
      <h1>{categoryName} Calculators</h1>
      <p class="category-lead">{description}</p>
      <ul class="chip-row sib" aria-label="Other categories">
        {siblings.map((c) => (<li><a class="chip" href={`/${c.slug}`} aria-current={c.slug === categorySlug ? 'page' : undefined}>{c.name}</a></li>))}
      </ul>
    </header>

    <div class="tools-directory-grid">
      {tools.map((tool) => (
        <a href={tool.href} class="card tool-card">
          <div class="tool-card-content">
            <h2 class="tool-card-title">{tool.name}</h2>
            <p class="tool-card-desc">{tool.description}</p>
          </div>
          <div class="tool-card-footer">
            <span class="open-tool-label">Use Calculator</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .category-hub-container { padding-top: var(--space-5); padding-bottom: clamp(3rem, 8vw, 6rem); }
  .category-header { padding-block: clamp(1.5rem, 4vw, 3rem) clamp(1.75rem, 4vw, 3rem); max-width: 52rem; }
  .category-badge-row { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4); }
  .tools-count { font-size: 0.875rem; font-weight: 600; color: var(--color-text-muted); }
  .category-header h1 { font-size: clamp(2.4rem, 5.5vw, 4.25rem); line-height: 1.04; letter-spacing: -0.03em; }
  .category-lead { margin-top: var(--space-4); font-size: 1.125rem; color: var(--color-text-muted); max-width: 46rem; }
  .sib { list-style: none; margin: var(--space-5) 0 0; padding: 0; }
  .tools-directory-grid { display: grid; grid-template-columns: 1fr; gap: 1.1rem; }
  @media (min-width: 700px) { .tools-directory-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .tools-directory-grid { grid-template-columns: repeat(3, 1fr); } }
  .tool-card { display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-5); padding: 1.5rem; text-decoration: none; color: var(--color-text); border-radius: var(--radius-2xl); transition: transform 200ms ease, box-shadow 200ms ease; }
  .tool-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); color: var(--color-text); }
  .tool-card-title { font-family: var(--font-display); font-size: 1.5rem; font-weight: 500; line-height: 1.15; }
  .tool-card-desc { margin-top: 0.5rem; font-size: 0.9375rem; color: var(--color-text-muted); }
  .tool-card-footer { display: flex; align-items: center; gap: 0.5rem; font-weight: 600; font-size: 0.9375rem; color: var(--color-link); }
</style>
