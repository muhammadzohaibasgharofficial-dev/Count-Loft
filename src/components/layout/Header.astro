---
/**
 * Count Loft — Site Header (SELENE chrome).
 * Same markup and Tailwind classes as SELENE's Chrome.tsx Header (src/selene is the design source),
 * with Count Loft links. Transparent over the hero on the homepage, solid glass on every other page.
 * Mobile menu is the SELENE full-screen overlay. This file is scanned by Tailwind (see src/selene/selene.css).
 */
const path = Astro.url.pathname;
const isHome = path === '/';

const nav = [
  { label: 'Finance', href: '/finance' },
  { label: 'Health', href: '/health' },
  { label: 'Math', href: '/math' },
  { label: 'Pakistan', href: '/pakistan' },
  { label: 'Islamic', href: '/islamic' },
  { label: 'About', href: '/about' },
];

// Full list for the mobile overlay (same links the old mobile drawer had).
const menu = [
  { label: 'All Tools', href: '/#all-tools' },
  { label: 'Calculators', href: '/calculators' },
  { label: 'Finance', href: '/finance' },
  { label: 'Health', href: '/health' },
  { label: 'Math', href: '/math' },
  { label: 'Construction', href: '/construction' },
  { label: 'Converters', href: '/converters' },
  { label: 'Pakistan', href: '/pakistan' },
  { label: 'Islamic', href: '/islamic' },
  { label: 'About', href: '/about' },
  { label: 'How to Use', href: '/calculators/how-to-use' },
  { label: 'Search', href: '/search' },
];

const isCurrent = (href: string) => href !== '/' && !href.includes('#') && (path === href || path.startsWith(href + '/'));
const bar = isHome ? '' : 'border-b border-regolith/15 bg-void/80 pb-3 backdrop-blur-xl';
---

<header class="site-header fixed inset-x-0 top-0 z-50 text-regolith" data-menu-root>
  <div class={`flex items-center justify-between px-4 pt-4 sm:px-6 sm:pt-5 md:px-[3vw] ${bar}`}>
    <a href="/" class="flex items-center gap-2.5 text-regolith no-underline" aria-label="Count Loft — home">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5">
        <path d="M15.5 3.2A9 9 0 1 0 20.8 16 7.2 7.2 0 0 1 15.5 3.2Z" fill="currentColor"></path>
      </svg>
      <span class="font-display text-[0.9375rem] tracking-[0.36em]">COUNT LOFT</span>
    </a>

    <nav aria-label="Main Navigation" class="hidden items-center gap-8 lg:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class="font-mono text-label text-regolith/70 uppercase no-underline transition-colors hover:text-regolith aria-[current=page]:text-regolith"
        >
          {item.label}
        </a>
      ))}
      <a href="/search" aria-label="Search all tools" class="font-mono text-label text-regolith/70 uppercase no-underline transition-colors hover:text-regolith">Search</a>
      <a href="/#all-tools" class="rounded-[4px] bg-regolith px-4 py-2.5 font-mono text-label text-void uppercase no-underline transition-colors hover:bg-earth hover:text-void">
        All tools
      </a>
    </nav>

    <button type="button" data-menu-button aria-expanded="false" aria-controls="menu" class="font-mono text-label uppercase lg:hidden">
      Menu
    </button>
  </div>

  <div
    id="menu"
    inert
    data-menu-panel
    class="pointer-events-none fixed inset-0 -z-10 flex flex-col justify-center gap-4 overflow-y-auto bg-void/95 px-6 py-24 opacity-0 backdrop-blur-xl transition-opacity data-[open=true]:pointer-events-auto data-[open=true]:opacity-100 lg:hidden"
  >
    {menu.map((item, i) => (
      <a href={item.href} class="flex items-baseline gap-4 font-display text-[1.25rem] tracking-[0.14em] text-regolith uppercase no-underline sm:text-[1.5rem]">
        <span class="font-mono text-label text-earth">{String(i + 1).padStart(2, '0')}</span>
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  const root = document.querySelector<HTMLElement>('[data-menu-root]');
  const button = root?.querySelector<HTMLButtonElement>('[data-menu-button]');
  const panel = root?.querySelector<HTMLElement>('[data-menu-panel]');

  const setOpen = (open: boolean) => {
    if (!button || !panel) return;
    panel.dataset.open = String(open);
    panel.toggleAttribute('inert', !open);
    button.setAttribute('aria-expanded', String(open));
    button.textContent = open ? 'Close' : 'Menu';
  };

  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>
