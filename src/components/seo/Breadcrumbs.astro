---
/**
 * Count Loft — Breadcrumbs Component
 * Semantic breadcrumb trail conforming to WCAG 2.2 AA.
 */
import type { BreadcrumbItem } from '@lib/format/breadcrumbs';

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol class="breadcrumb-list">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="breadcrumb-item">
          {index > 0 && <span class="breadcrumb-separator" aria-hidden="true">/</span>}
          {isLast || !item.href ? (
            <span class="breadcrumb-current" aria-current="page">{item.label}</span>
          ) : (
            <a href={item.href} class="breadcrumb-link">{item.label}</a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumbs {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-2);
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumb-separator {
    color: var(--color-border-strong);
    user-select: none;
  }

  .breadcrumb-link {
    color: var(--color-link);
    text-decoration: none;
  }

  .breadcrumb-link:hover {
    text-decoration: underline;
  }

  .breadcrumb-current {
    color: var(--color-text);
    font-weight: var(--font-weight-medium);
  }
</style>
