---
/**
 * Count Loft — SEO Metadata Head Component
 * Manages document title, description, canonical link, OpenGraph, and Twitter cards.
 */

import { SITE_URL, SITE_NAME, absoluteUrl } from '@lib/seo/site';
import { SEARCH_CONSOLE_VERIFICATION } from '@lib/seo/analytics';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  robots?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  canonicalUrl,
  robots = 'index, follow',
  ogType = 'website'
} = Astro.props;

// Determine clean canonical URL without query parameters
// Canonical format: no trailing slash (matches trailingSlash: 'never'); root stays "/"
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath.length > 1 ? rawPath.replace(/\/+$/, '') : rawPath;
const cleanCanonical = canonicalUrl || new URL(normalizedPath, Astro.site || SITE_URL).href;
const siteTitle = SITE_NAME;
const ogImage = absoluteUrl('/og-image.png');
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={cleanCanonical} />
<meta name="robots" content={robots} />
{SEARCH_CONSOLE_VERIFICATION && <meta name="google-site-verification" content={SEARCH_CONSOLE_VERIFICATION} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<meta name="theme-color" content="#2563EB" />

<!-- OpenGraph Metadata -->
<meta property="og:site_name" content={siteTitle} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={cleanCanonical} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Count Loft — free online calculators" />

<!-- Twitter Card Metadata  -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
