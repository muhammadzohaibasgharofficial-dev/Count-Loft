---
/**
 * Count Loft — Share Calculator URL Button
 * Uses Web Share API with safe fallback to copying URL to clipboard.
 */

export interface Props {
  title?: string;
  label?: string;
}

const {
  title = 'Count Loft Calculator',
  label = 'Share'
} = Astro.props;
---

<button
  type="button"
  class="btn btn-ghost share-url-btn"
  data-share-title={title}
  aria-label="Share this calculator"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="18" cy="5" r="3"></circle>
    <circle cx="6" cy="12" r="3"></circle>
    <circle cx="18" cy="19" r="3"></circle>
    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
  </svg>
  <span>{label}</span>
</button>

<script>
  function setupShareButtons() {
    document.querySelectorAll<HTMLButtonElement>('.share-url-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const title = btn.getAttribute('data-share-title') || document.title;
        const url = window.location.href;

        if (navigator.share) {
          try {
            await navigator.share({ title, url });
            return;
          } catch {
            // User cancelled or unsupported
          }
        }

        // Fallback: copy URL to clipboard
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(url);
          }
          const toastFn = (window as unknown as { showCountLoftToast?: (msg: string) => void }).showCountLoftToast;
          if (typeof toastFn === 'function') {
            toastFn('Link copied to clipboard');
          }
        } catch {
          // Graceful fallback
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupShareButtons);
  } else {
    setupShareButtons();
  }
</script>
