---
/**
 * Count Loft — Theme Toggle Component
 * Reusable light/dark switch powered by @lib/storage/theme.ts
 */
---

<button
  type="button"
  class="btn btn-ghost theme-toggle"
  aria-label="Toggle light and dark theme"
  title="Toggle theme"
  aria-pressed="false"
>
  <!-- Sun Icon (shown in dark mode) -->
  <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <!-- Moon Icon (shown in light mode) -->
  <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <span class="visually-hidden">Toggle color theme</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--min-touch-target);
    min-height: var(--min-touch-target);
    padding: var(--space-2);
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  /* In light theme (default), show moon icon, hide sun icon */
  :root .icon-sun,
  :root[data-theme="light"] .icon-sun {
    display: none;
  }
  :root .icon-moon,
  :root[data-theme="light"] .icon-moon {
    display: inline-block;
  }

  /* In dark theme, show sun icon, hide moon icon */
  :root[data-theme="dark"] .icon-sun {
    display: inline-block;
  }
  :root[data-theme="dark"] .icon-moon {
    display: none;
  }
</style>

<script>
  import { toggleTheme, getActiveTheme } from '@lib/storage/theme';

  function initThemeToggles() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');
    if (buttons.length === 0) return;

    // 1. Initial accessibility state sync
    const active = getActiveTheme();
    buttons.forEach((btn) => {
      btn.setAttribute('aria-pressed', active === 'dark' ? 'true' : 'false');

      // 2. Click handler using existing theme module
      btn.addEventListener('click', () => {
        const next = toggleTheme();
        buttons.forEach((b) => {
          b.setAttribute('aria-pressed', next === 'dark' ? 'true' : 'false');
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeToggles);
  } else {
    initThemeToggles();
  }
</script>
