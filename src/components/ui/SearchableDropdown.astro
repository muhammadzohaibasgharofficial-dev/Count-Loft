---
interface Props {
  name: string;
  options: { label: string; value: string }[];
  placeholder?: string;
  selected?: string;
  id?: string;
}
  name: string;
  options: { label: string; value: string }[];
  placeholder?: string;
  selected?: string;
}
const { name, options, placeholder = 'Search or select...', selected } = Astro.props;
---
<div class="searchable-dropdown" data-name={name}>
  <input type="hidden" name={name} class="dropdown-value" value={selected ?? ''} />
  <div class="dropdown-toggle" tabindex="0">
    <input type="text" class="dropdown-input" placeholder={placeholder} autocomplete="off" value="" />
    <span class="dropdown-arrow">▼</span>
  </div>
  <ul class="dropdown-list hidden">
    {options.map(opt => (
      <li class="dropdown-item" data-value={opt.value} data-label={opt.label}>{opt.label}</li>
    ))}
    <li class="dropdown-no-results hidden">No results found</li>
  </ul>
</div>

<style>
  .searchable-dropdown { position: relative; max-width: 100%; }
  .dropdown-toggle { display: flex; align-items: center; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-2); background: var(--color-surface); cursor: pointer; }
  .dropdown-input { border: none; outline: none; flex: 1; font: inherit; background: transparent; }
  .dropdown-arrow { margin-left: var(--space-2); }
  .dropdown-list { position: absolute; top: 100%; left: 0; right: 0; margin-top: 4px; padding: 0; list-style: none; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); max-height: 200px; overflow-y: auto; z-index: 10; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
  .dropdown-item, .dropdown-no-results { padding: var(--space-2) var(--space-3); cursor: pointer; }
  .dropdown-item:hover { background: var(--color-primary-100); }
  .hidden { display: none; }
</style>

<script client:load>
  const container = document.currentScript.parentElement!;
  const input = container.querySelector('.dropdown-input') as HTMLInputElement;
  const hidden = container.querySelector('.dropdown-value') as HTMLInputElement;
  const list = container.querySelector('.dropdown-list') as HTMLUListElement;
  const items = Array.from(container.querySelectorAll('.dropdown-item')) as HTMLLIElement[];
  const noResults = container.querySelector('.dropdown-no-results') as HTMLLIElement;

  function open() { list.classList.remove('hidden'); }
  function close() { list.classList.add('hidden'); }
  function setValue(value: string, label: string) { hidden.value = value; input.value = label; close(); }

  input.addEventListener('focus', open);
  input.addEventListener('input', () => {
    const q = input.value.toLowerCase();
    let hits = 0;
    items.forEach(item => {
      const txt = item.dataset.label!.toLowerCase();
      if (txt.includes(q)) { item.classList.remove('hidden'); hits++; } else { item.classList.add('hidden'); }
    });
    noResults.classList.toggle('hidden', hits > 0);
    open();
  });
  items.forEach(item => {
    item.addEventListener('click', () => {
      setValue(item.dataset.value!, item.dataset.label!);
    });
  });
  document.addEventListener('click', (e) => {
    if (!container.contains(e.target as Node)) close();
  });

  // Initialize with preselected value if present
  if (hidden.value) {
    const sel = items.find(i => i.dataset.value === hidden.value);
    if (sel) input.value = sel.dataset.label!;
  }
</script>
