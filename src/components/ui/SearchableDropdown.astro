
---
interface Props {
  name: string;
  options: { label: string; value: string }[];
  placeholder?: string;
  selected?: string;
  id?: string;
}

const {
  name,
  options,
  placeholder = 'Search or select...',
  selected = '',
  id
} = Astro.props;
---

<div
  class="searchable-dropdown"
  data-name={name}
  id={id}
>
  <input
    type="hidden"
    name={name}
    class="dropdown-value"
    value={selected}
  />

  <div class="dropdown-toggle">
    <input
      type="text"
      class="dropdown-input"
      placeholder={placeholder}
      autocomplete="off"
      value={options.find((opt) => opt.value === selected)?.label ?? ''}
    />
    <span class="dropdown-arrow">▼</span>
  </div>

  <ul class="dropdown-list hidden">
    {options.map((opt) => (
      <li
        class="dropdown-item"
        data-value={opt.value}
        data-label={opt.label}
      >
        {opt.label}
      </li>
    ))}

    <li class="dropdown-no-results hidden">
      No results found
    </li>
  </ul>
</div>

<style>
  .searchable-dropdown {
    position: relative;
    width: 100%;
    max-width: 100%;
  }

  .dropdown-toggle {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    background: var(--color-surface);
    cursor: pointer;
  }

  .dropdown-input {
    width: 100%;
    min-width: 0;
    border: none;
    outline: none;
    flex: 1;
    font: inherit;
    background: transparent;
    color: inherit;
  }

  .dropdown-arrow {
    margin-left: var(--space-2);
    flex-shrink: 0;
    font-size: 12px;
  }

  .dropdown-list {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: 4px;
    padding: 0;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    max-height: 220px;
    overflow-y: auto;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .dropdown-item,
  .dropdown-no-results {
    padding: var(--space-2) var(--space-3);
  }

  .dropdown-item {
    cursor: pointer;
  }

  .dropdown-item:hover {
    background: var(--color-primary-100);
  }

  .dropdown-no-results {
    cursor: default;
    opacity: 0.7;
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  function initializeSearchableDropdowns() {
    const containers = document.querySelectorAll<HTMLElement>(
      '.searchable-dropdown'
    );

    containers.forEach((container) => {
      if (container.dataset.initialized === 'true') return;

      container.dataset.initialized = 'true';

      const input = container.querySelector<HTMLInputElement>(
        '.dropdown-input'
      );

      const hidden = container.querySelector<HTMLInputElement>(
        '.dropdown-value'
      );

      const list = container.querySelector<HTMLUListElement>(
        '.dropdown-list'
      );

      const items = Array.from(
        container.querySelectorAll<HTMLLIElement>('.dropdown-item')
      );

      const noResults = container.querySelector<HTMLLIElement>(
        '.dropdown-no-results'
      );

      if (!input || !hidden || !list || !noResults) return;

      function open() {
        list.classList.remove('hidden');
      }

      function close() {
        list.classList.add('hidden');
      }

      function setValue(value: string, label: string) {
        hidden.value = value;
        input.value = label;

        hidden.dispatchEvent(
          new Event('change', { bubbles: true })
        );

        close();
      }

      function filterOptions() {
        const query = input.value.trim().toLowerCase();
        let matches = 0;

        items.forEach((item) => {
          const label = (
            item.dataset.label ?? ''
          ).toLowerCase();

          const isMatch = label.includes(query);

          item.classList.toggle('hidden', !isMatch);

          if (isMatch) matches++;
        });

        noResults.classList.toggle(
          'hidden',
          matches > 0
        );
      }

      input.addEventListener('focus', () => {
        filterOptions();
        open();
      });

      input.addEventListener('input', () => {
        filterOptions();
        open();
      });

      input.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          close();
          input.blur();
        }

        if (event.key === 'ArrowDown') {
          event.preventDefault();

          const firstVisible = items.find(
            (item) => !item.classList.contains('hidden')
          );

          firstVisible?.focus();
        }
      });

      items.forEach((item) => {
        item.addEventListener('click', () => {
          setValue(
            item.dataset.value ?? '',
            item.dataset.label ?? ''
          );
        });

        item.setAttribute('tabindex', '0');

        item.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();

            setValue(
              item.dataset.value ?? '',
              item.dataset.label ?? ''
            );

            input.focus();
          }
        });
      });

      document.addEventListener('click', (event) => {
        if (!container.contains(event.target as Node)) {
          close();
        }
      });
    });
  }

  initializeSearchableDropdowns();

  document.addEventListener(
    'astro:page-load',
    initializeSearchableDropdowns
  );
</script>
