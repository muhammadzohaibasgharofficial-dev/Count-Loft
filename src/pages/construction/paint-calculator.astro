---
import ToolShell from '@components/tool/ToolShell.astro';
import FaqAccordion from '@components/tool/FaqAccordion.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { buildBreadcrumbs } from '@lib/format/breadcrumbs';
import { generateWebApplicationJsonLd, generateFaqJsonLd, generateBreadcrumbJsonLd } from '@lib/seo/jsonld';

const breadcrumbs = buildBreadcrumbs([
  { label: 'Construction', href: '/construction' },
  { label: 'Paint Calculator' }
]);

const faqs = [
  {
    question: 'How many square feet does one gallon of paint cover?',
    answer: 'One standard US gallon of interior wall paint covers approximately 350 to 400 square feet on smooth, primed walls. Textured walls or unprimed drywall absorb more paint, reducing coverage to ~250–300 sq ft.'
  },
  {
    question: 'How do you account for doors and windows?',
    answer: 'Standard interior doors subtract roughly 21 square feet each. Standard residential windows subtract approximately 15 square feet each from total wall surface area.'
  },
  {
    question: 'Should I apply one coat or two coats?',
    answer: 'Two coats are strongly recommended for durable sheen, uniform color depth, and complete hiding—especially when transitioning between light and dark shades.'
  },
  {
    question: 'How do I calculate paint needed for ceilings?',
    answer: 'Ceiling area is simply room length multiplied by room width. Divide that ceiling square footage by 350 sq ft per gallon.'
  },
  {
    question: 'What should I do with leftover paint?',
    answer: 'Store remaining paint in an airtight, labeled container in a temperature-controlled area for future spot touch-ups. Avoid freezing temperatures.'
  }
];

const webAppSchema = generateWebApplicationJsonLd({
  name: 'Paint Calculator — Count Loft',
  description: 'Estimate paint gallons, quarts, and total wall surface coverage for interior painting projects.',
  url: '/construction/paint-calculator',
  category: 'WebApplication'
});
---

<ToolShell
  title="Paint Calculator"
  description="Calculate paint gallons and quarts needed for interior rooms, factoring in ceiling height, doors, windows, and coats."
  category="construction"
  breadcrumbs={breadcrumbs}
  author="Count Loft Team"
  lastUpdated="2026-10-31"
>
  <div slot="inputs">
    <form id="paint-form" novalidate onsubmit="return false;">
      <div class="form-row-2">
        <div class="form-group">
          <label for="pnt-length" class="form-label">Room Length (Feet)</label>
          <input type="number" id="pnt-length" class="form-input" value="14" min="1" step="0.5" />
        </div>
        <div class="form-group">
          <label for="pnt-width" class="form-label">Room Width (Feet)</label>
          <input type="number" id="pnt-width" class="form-input" value="12" min="1" step="0.5" />
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="pnt-height" class="form-label">Ceiling Height (Feet)</label>
          <input type="number" id="pnt-height" class="form-input" value="9" min="6" max="25" step="0.5" />
        </div>
        <div class="form-group">
          <label for="pnt-coats" class="form-label">Number of Coats</label>
          <select id="pnt-coats" class="form-input">
            <option value="1">1 Coat (Touch-up / Same Color)</option>
            <option value="2" selected>2 Coats (Standard Recommendation)</option>
            <option value="3">3 Coats (Major Color Change)</option>
          </select>
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="pnt-doors" class="form-label">Doors to Deduct</label>
          <input type="number" id="pnt-doors" class="form-input" value="1" min="0" max="10" />
        </div>
        <div class="form-group">
          <label for="pnt-windows" class="form-label">Windows to Deduct</label>
          <input type="number" id="pnt-windows" class="form-input" value="2" min="0" max="15" />
        </div>
      </div>
    </form>
  </div>

  <div slot="results">
    <div class="result-hero">
      <span class="result-hero-label">Total Paint Required</span>
      <span class="result-hero-value" id="pnt-gallons-val">3 Gallons</span>
      <span class="result-hero-subtext" id="pnt-quarts-val">10 Quarts equivalent</span>
    </div>

    <div class="pnt-breakdown-table">
      <div class="breakdown-row">
        <span>Net Wall Surface Area:</span>
        <strong id="pnt-area-val">417 sq ft</strong>
      </div>
      <div class="breakdown-row">
        <span>Total Surface (All Coats):</span>
        <strong id="pnt-total-surface">834 sq ft</strong>
      </div>
      <div class="breakdown-row">
        <span>Coverage Standard:</span>
        <strong>350 sq ft / gallon</strong>
      </div>
    </div>
  </div>

  <div slot="how-to">
    <ol>
      <li><strong>Enter room dimensions:</strong> Measure floor length, floor width, and ceiling height in feet.</li>
      <li><strong>Count openings:</strong> Input the number of standard doorways and windows to subtract non-painted surfaces.</li>
      <li><strong>Select coat coverage:</strong> Two coats ensure uniform color saturation and wipeable finish durability.</li>
    </ol>
  </div>

  <div slot="formula">
    <pre><code>Gross Wall Area = 2 × (Length + Width) × Ceiling Height
Deductions      = (Doors × 21 sq ft) + (Windows × 15 sq ft)
Net Wall Area   = Gross Wall Area − Deductions
Gallons Needed  = ⌈ (Net Wall Area × Coats) ÷ 350 ⌉</code></pre>
  </div>

  <div slot="examples-table">
    <table class="data-table">
      <thead>
        <tr>
          <th>Room Size (9' Ceiling)</th>
          <th>Net Wall Area</th>
          <th>1 Coat</th>
          <th>2 Coats</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>10 ft × 10 ft (Small Bedroom)</td><td>309 sq ft</td><td>1 Gallon</td><td>2 Gallons</td></tr>
        <tr><td>12 ft × 14 ft (Standard Bedroom)</td><td>417 sq ft</td><td>2 Gallons</td><td>3 Gallons</td></tr>
        <tr><td>16 ft × 20 ft (Living Room)</td><td>597 sq ft</td><td>2 Gallons</td><td>4 Gallons</td></tr>
        <tr><td>20 ft × 24 ft (Open Great Room)</td><td>741 sq ft</td><td>3 Gallons</td><td>5 Gallons</td></tr>
      </tbody>
    </table>
  </div>

  <div slot="faq">
    <FaqAccordion items={faqs} />
  </div>

  <div slot="related-tools">
    <div class="related-tools-grid">
      <a href="/construction/square-footage-calculator" class="card related-tool-card">
        <h3>Square Footage Calculator</h3>
        <p>Calculate floor and ceiling surface area in square feet and meters.</p>
      </a>
      <a href="/construction/tile-calculator" class="card related-tool-card">
        <h3>Tile Calculator</h3>
        <p>Determine exact tile counts and cartons needed for walls and floors.</p>
      </a>
    </div>
  </div>
</ToolShell>

<JsonLd schema={[webAppSchema, generateFaqJsonLd(faqs), generateBreadcrumbJsonLd([{ name: 'Home', item: '/' }, { name: 'Construction', item: '/construction' }, { name: 'Paint Calculator', item: '/construction/paint-calculator' }])]} />

<style>
  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pnt-breakdown-table {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
  }
</style>

<script>
  import { calculatePaint } from '@lib/calc/construction';
  import { parseNumberInput } from '@lib/format/number';

  function initPaint() {
    const lenIn = document.getElementById('pnt-length') as HTMLInputElement | null;
    const widIn = document.getElementById('pnt-width') as HTMLInputElement | null;
    const hgtIn = document.getElementById('pnt-height') as HTMLInputElement | null;
    const coatsIn = document.getElementById('pnt-coats') as HTMLSelectElement | null;
    const doorsIn = document.getElementById('pnt-doors') as HTMLInputElement | null;
    const windowsIn = document.getElementById('pnt-windows') as HTMLInputElement | null;

    const gallonsDisplay = document.getElementById('pnt-gallons-val');
    const quartsDisplay = document.getElementById('pnt-quarts-val');
    const areaDisplay = document.getElementById('pnt-area-val');
    const surfaceDisplay = document.getElementById('pnt-total-surface');

    function update() {
      const length = parseNumberInput(lenIn?.value, 14);
      const width = parseNumberInput(widIn?.value, 12);
      const height = parseNumberInput(hgtIn?.value, 9);
      const coats = parseNumberInput(coatsIn?.value, 2);
      const doors = parseNumberInput(doorsIn?.value, 1);
      const windows = parseNumberInput(windowsIn?.value, 2);

      const res = calculatePaint(length, width, height, doors, windows, coats);

      if (gallonsDisplay) gallonsDisplay.textContent = `${res.gallonsNeeded} Gallon${res.gallonsNeeded > 1 ? 's' : ''}`;
      if (quartsDisplay) quartsDisplay.textContent = `${res.quartsNeeded} Quarts equivalent`;
      if (areaDisplay) areaDisplay.textContent = `${res.totalWallAreaSqFt} sq ft`;
      if (surfaceDisplay) surfaceDisplay.textContent = `${res.totalWallAreaSqFt * coats} sq ft`;
    }

    [lenIn, widIn, hgtIn, coatsIn, doorsIn, windowsIn].forEach(i => {
      i?.addEventListener('input', update);
      i?.addEventListener('change', update);
    });
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPaint);
  } else {
    initPaint();
  }
</script>
