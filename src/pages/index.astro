---
/**
 * Count Loft — Homepage
 * Searchable directory, category hubs, featured calculators, and zero-data privacy callout.
 */
import BaseLayout from '@components/layout/BaseLayout.astro';
import { CALCULATORS, CATEGORIES_CONFIG } from '@data/calculators';

const featuredTools = CALCULATORS.filter(c =>
  ['loan-calculator', 'percentage-calculator', 'bmi-calculator', 'mortgage-calculator', 'calorie-calculator', 'compound-interest-calculator'].includes(c.slug)
);
---

<BaseLayout
  title="Count Loft — 42 Free Online Calculators for Finance, Health & Math"
  description="Fast, accessible, and trustworthy online calculation tools. Instant results, formulas, worked examples, and charts with zero data tracking."
>
  <div class="homepage-wrapper">
    <!-- Hero Banner & Search -->
    <section class="hero-section">
      <div class="container hero-container">
        <h1 class="hero-title">
          Fast, Free & Trustworthy <br /><span class="hero-highlight">Online Calculators</span>
        </h1>
        <p class="hero-subtitle">
          Instant calculations for loans, mortgages, health, conversions, and math.
          <strong class="privacy-note">Your numbers never leave your browser.</strong>
        </p>

        <!-- Live Instant Filter Search -->
        <div class="search-box-wrapper">
          <label for="calculator-search" class="visually-hidden">Search all 42 calculators</label>
          <div class="search-input-box">
            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="calculator-search"
              class="form-input search-input"
              placeholder="Search 42 calculators (e.g. loan, bmi, percentage, concrete)..."
              autocomplete="off"
            />
          </div>
          <div id="search-results-dropdown" class="search-dropdown" hidden>
            <ul id="search-results-list" class="search-results-list" role="listbox">
              <!-- Dynamically populated via client-side search -->
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Categories Grid -->
    <section class="categories-section">
      <div class="container">
        <div class="section-header">
          <h2>Browse by Category</h2>
          <p class="section-lead">Explore our complete catalog organized across 6 primary sectors.</p>
        </div>

        <div class="category-cards-grid">
          {CATEGORIES_CONFIG.map((cat) => (
            <a href={`/${cat.slug}`} class="card category-card">
              <div class="category-card-top">
                <span class="category-card-name">{cat.name}</span>
                <span class="category-card-count">{cat.count} Tools</span>
              </div>
              <p class="category-card-desc">{cat.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Calculators -->
    <section class="featured-section">
      <div class="container">
        <div class="section-header">
          <h2>Popular Calculators</h2>
          <p class="section-lead">Most frequently used tools with instant formulas and interactive charts.</p>
        </div>

        <div class="featured-grid">
          {featuredTools.map((tool) => (
            <a href={tool.href} class="card featured-card">
              <span class="featured-badge">{tool.category.toUpperCase()}</span>
              <h3>{tool.name}</h3>
              <p>{tool.description}</p>
              <span class="featured-cta">Open Calculator &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Trust & Privacy Banner -->
    <section class="trust-banner-section">
      <div class="container">
        <div class="card trust-banner-card">
          <div class="trust-icon-box">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <div class="trust-text-box">
            <h3>Privacy by Architecture</h3>
            <p>
              Unlike traditional calculator websites, Count Loft runs 100% in your browser.
              No inputs, salaries, or health metrics are sent across the network or stored in databases.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero-section {
    padding: var(--space-7) 0 var(--space-6) 0;
    text-align: center;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-container {
    max-width: var(--container-narrow);
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    letter-spacing: -0.03em;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-3) 0;
  }

  .hero-highlight {
    color: var(--color-primary);
  }

  .hero-subtitle {
    font-size: var(--text-body);
    color: var(--color-text-muted);
    max-width: 58ch;
    margin: 0 auto var(--space-5) auto;
    line-height: var(--leading-normal);
  }

  .privacy-note {
    display: block;
    color: var(--color-text);
    margin-top: var(--space-1);
  }

  .search-box-wrapper {
    position: relative;
    max-width: 540px;
    margin: 0 auto;
    text-align: left;
  }

  .search-input-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: var(--space-4);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-input {
    padding-left: 2.75rem;
    height: 3rem;
    border-radius: var(--radius-full);
    font-size: var(--text-body);
    box-shadow: var(--shadow-sm);
  }

  .search-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: var(--space-2);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    max-height: 320px;
    overflow-y: auto;
    z-index: 50;
  }

  .search-results-list {
    list-style: none;
    margin: 0;
    padding: var(--space-2) 0;
  }

  .search-results-list :global(li a) {
    display: block;
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: var(--color-text);
  }

  .search-results-list :global(li a:hover) {
    background-color: var(--color-surface-muted);
    color: var(--color-link);
  }

  .categories-section,
  .featured-section {
    padding: var(--space-7) 0;
  }

  .section-header {
    margin-bottom: var(--space-5);
  }

  .section-header h2 {
    margin: 0;
    font-size: var(--text-h2);
  }

  .section-lead {
    color: var(--color-text-muted);
    font-size: var(--text-body);
    margin-top: var(--space-1);
  }

  .category-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .category-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .category-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .category-card {
    padding: var(--space-5);
    text-decoration: none;
    color: var(--color-text);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .category-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .category-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .category-card-name {
    font-size: 1.125rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-link);
  }

  .category-card-count {
    font-size: var(--text-xs);
    background-color: var(--color-surface-muted);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
  }

  .category-card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--leading-normal);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .featured-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .featured-card {
    padding: var(--space-5);
    text-decoration: none;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .featured-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .featured-badge {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .featured-card h3 {
    margin: 0 0 var(--space-2) 0;
    font-size: 1.125rem;
  }

  .featured-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4) 0;
    flex-grow: 1;
  }

  .featured-cta {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-link);
  }

  .trust-banner-section {
    padding: var(--space-4) 0 var(--space-8) 0;
  }

  .trust-banner-card {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6);
    background-color: var(--color-surface);
  }

  .trust-icon-box {
    color: var(--color-secondary);
    flex-shrink: 0;
  }

  .trust-text-box h3 {
    margin: 0 0 var(--space-1) 0;
    font-size: 1.125rem;
  }

  .trust-text-box p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }
</style>

<script>
  import { CALCULATORS } from '@data/calculators';

  function initLiveSearch() {
    const input = document.getElementById('calculator-search') as HTMLInputElement | null;
    const dropdown = document.getElementById('search-results-dropdown');
    const list = document.getElementById('search-results-list');

    if (!input || !dropdown || !list) return;

    input.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();

      if (!query) {
        dropdown.setAttribute('hidden', '');
        list.innerHTML = '';
        return;
      }

      const matches = CALCULATORS.filter(c =>
        c.name.toLowerCase().includes(query) ||
        c.description.toLowerCase().includes(query) ||
        c.category.toLowerCase().includes(query)
      ).slice(0, 8);

      if (matches.length === 0) {
        list.innerHTML = `<li style="padding: 12px 16px; color: var(--color-text-muted); font-size: 14px;">No calculators found for "${query}"</li>`;
      } else {
        list.innerHTML = matches.map(m => `
          <li>
            <a href="${m.href}">
              <div style="font-weight: 600; font-size: 14px;">${m.name}</div>
              <div style="font-size: 12px; color: var(--color-text-muted);">${m.description}</div>
            </a>
          </li>
        `).join('');
      }

      dropdown.removeAttribute('hidden');
    });

    // Close dropdown on click outside
    document.addEventListener('click', (e) => {
      if (!input.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
        dropdown.setAttribute('hidden', '');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLiveSearch);
  } else {
    initLiveSearch();
  }
</script>
