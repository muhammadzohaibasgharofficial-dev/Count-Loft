---
import ToolShell from '@components/tool/ToolShell.astro';
import FaqAccordion from '@components/tool/FaqAccordion.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { buildBreadcrumbs } from '@lib/format/breadcrumbs';
import { generateWebApplicationJsonLd, generateFaqJsonLd, generateBreadcrumbJsonLd } from '@lib/seo/jsonld';

const breadcrumbs = buildBreadcrumbs([
  { label: 'Math', href: '/math' },
  { label: 'Percentage Change Calculator' }
]);

const faqs = [
  {
    question: 'How do you calculate percentage change?',
    answer: 'Subtract the old value from the new value, divide that difference by the absolute value of the old value, and multiply by 100: ((New − Old) ÷ |Old|) × 100.'
  },
  {
    question: 'What is the difference between percentage change and percentage point change?',
    answer: 'Percentage change measures the relative growth or decline proportional to the initial value. Percentage points measure the direct arithmetic difference between two percentages (e.g., going from 5% to 7% is a 2 percentage point increase, but a 40% increase).'
  },
  {
    question: 'Why does an increase of 50% followed by a decrease of 50% not return to the original value?',
    answer: 'Because the base shifts. If you start with $100 and increase 50%, you reach $150. A 50% decrease of $150 reduces the value by $75, leaving $75.'
  },
  {
    question: 'Can percentage change be negative?',
    answer: 'Yes. A negative result indicates a percentage decrease, whereas a positive result indicates a percentage increase.'
  },
  {
    question: 'Can you calculate percentage change from zero?',
    answer: 'Mathematically, division by zero is undefined. Moving from 0 to any positive number cannot be expressed as a standard finite percentage change.'
  }
];

const webAppSchema = generateWebApplicationJsonLd({
  name: 'Percentage Change Calculator — Count Loft',
  description: 'Calculate percentage increase, percentage decrease, and absolute differences between two values.',
  url: 'https://count-loft.com/math/percentage-change-calculator',
  category: 'WebApplication'
});
---

<ToolShell
  title="Percentage Change Calculator"
  description="Calculate percentage increase, percentage decrease, relative growth rate, and difference between two numbers."
  category="math"
  breadcrumbs={breadcrumbs}
  author="Count Loft Team"
  lastUpdated="2026-10-31"
>
  <div slot="inputs">
    <form id="pct-change-form" novalidate onsubmit="return false;">
      <div class="form-row-2">
        <div class="form-group">
          <label for="pct-old-val" class="form-label">Initial Value (From)</label>
          <input type="number" id="pct-old-val" class="form-input" value="80" step="any" />
        </div>
        <div class="form-group">
          <label for="pct-new-val" class="form-label">Final Value (To)</label>
          <input type="number" id="pct-new-val" class="form-input" value="100" step="any" />
        </div>
      </div>
    </form>
  </div>

  <div slot="results">
    <div class="result-hero">
      <span class="result-hero-label">Percentage Change</span>
      <span class="result-hero-value" id="pct-change-val">+25.0%</span>
      <span class="result-hero-subtext" id="pct-direction-val">Increase of 20 units</span>
    </div>

    <div class="pct-breakdown-table">
      <div class="breakdown-row">
        <span>Absolute Difference:</span>
        <strong id="pct-diff-val">20</strong>
      </div>
      <div class="breakdown-row">
        <span>Calculation Step:</span>
        <strong id="pct-formula-step">((100 − 80) ÷ 80) × 100 = 25%</strong>
      </div>
    </div>
  </div>

  <div slot="how-to">
    <ol>
      <li><strong>Enter the initial starting value:</strong> The historical, benchmark, or original number.</li>
      <li><strong>Enter the final new value:</strong> The updated, current, or target number.</li>
      <li><strong>Review results:</strong> The calculator instantly detects whether the change is an increase, decrease, or unchanged.</li>
    </ol>
  </div>

  <div slot="formula">
    <pre><code>Percentage Change = [ (Final Value − Initial Value) ÷ |Initial Value| ] × 100

If Result > 0: Percentage Increase
If Result < 0: Percentage Decrease</code></pre>
  </div>

  <div slot="examples-table">
    <table class="data-table">
      <thead>
        <tr>
          <th>Initial Value</th>
          <th>Final Value</th>
          <th>Change (%)</th>
          <th>Nature</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>50</td><td>75</td><td>+50.0%</td><td>Increase</td></tr>
        <tr><td>80</td><td>100</td><td>+25.0%</td><td>Increase</td></tr>
        <tr><td>100</td><td>80</td><td>−20.0%</td><td>Decrease</td></tr>
        <tr><td>200</td><td>150</td><td>−25.0%</td><td>Decrease</td></tr>
      </tbody>
    </table>
  </div>

  <div slot="faq">
    <FaqAccordion items={faqs} />
  </div>

  <div slot="related-tools">
    <div class="related-tools-grid">
      <a href="/math/percentage-calculator" class="card related-tool-card">
        <h3>Percentage Calculator</h3>
        <p>Calculate what is X% of Y and what percentage X is of Y.</p>
      </a>
      <a href="/finance/tip-and-discount-calculator" class="card related-tool-card">
        <h3>Tip & Discount Calculator</h3>
        <p>Calculate sale discounts, final bill amounts, and custom tips.</p>
      </a>
    </div>
  </div>
</ToolShell>

<JsonLd schema={[webAppSchema, generateFaqJsonLd(faqs), generateBreadcrumbJsonLd([{ name: 'Home', item: '/' }, { name: 'Math', item: '/math' }, { name: 'Percentage Change Calculator', item: '/math/percentage-change-calculator' }])]} />

<style>
  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pct-breakdown-table {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
  }
</style>

<script>
  import { calculatePercentageChange } from '@lib/calc/percentage';
  import { parseNumberInput } from '@lib/format/number';

  function initPctChange() {
    const oldIn = document.getElementById('pct-old-val') as HTMLInputElement | null;
    const newIn = document.getElementById('pct-new-val') as HTMLInputElement | null;

    const changeDisplay = document.getElementById('pct-change-val');
    const directionDisplay = document.getElementById('pct-direction-val');
    const diffDisplay = document.getElementById('pct-diff-val');
    const formulaDisplay = document.getElementById('pct-formula-step');

    function update() {
      const oldVal = parseNumberInput(oldIn?.value, 80);
      const newVal = parseNumberInput(newIn?.value, 100);

      const res = calculatePercentageChange(oldVal, newVal);

      const sign = res.changePercent > 0 ? '+' : '';
      if (changeDisplay) changeDisplay.textContent = `${sign}${res.changePercent}%`;

      if (directionDisplay) {
        if (res.direction === 'increase') {
          directionDisplay.textContent = `Increase of ${Math.abs(res.difference)} units`;
        } else if (res.direction === 'decrease') {
          directionDisplay.textContent = `Decrease of ${Math.abs(res.difference)} units`;
        } else {
          directionDisplay.textContent = 'No change (0 units)';
        }
      }

      if (diffDisplay) diffDisplay.textContent = `${res.difference > 0 ? '+' : ''}${res.difference}`;
      if (formulaDisplay) formulaDisplay.textContent = res.formula;
    }

    oldIn?.addEventListener('input', update);
    newIn?.addEventListener('input', update);
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPctChange);
  } else {
    initPctChange();
  }
</script>
