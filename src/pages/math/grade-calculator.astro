---
import ToolShell from '@components/tool/ToolShell.astro';
import FaqAccordion from '@components/tool/FaqAccordion.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { buildBreadcrumbs } from '@lib/format/breadcrumbs';
import { generateWebApplicationJsonLd, generateFaqJsonLd, generateBreadcrumbJsonLd } from '@lib/seo/jsonld';

const breadcrumbs = buildBreadcrumbs([
  { label: 'Math', href: '/math' },
  { label: 'Grade Calculator' }
]);

const faqs = [
  {
    question: 'How do you calculate a weighted grade?',
    answer: 'Multiply each assignment or exam grade by its assigned weight percentage, sum these products together, and divide by the total sum of weights: Weighted Grade = Σ (Grade × Weight) ÷ Σ (Weight).'
  },
  {
    question: 'How do you calculate what score you need on the final exam?',
    answer: 'Use the formula: Required Final Score = [ Target Class Grade − (Current Grade × Current Weight) ] ÷ Final Exam Weight. For example, if you have an 85% going into a 30% final and want a 90% overall, you need a 101.7%.'
  },
  {
    question: 'What if total weights do not add up to 100%?',
    answer: 'If your semester is still in progress and completed assignments total less than 100% (e.g., 70%), the calculator normalizes your average by dividing by 70%, showing your true current standing.'
  },
  {
    question: 'What is the standard college grading scale?',
    answer: 'Standard letter grades are: A (93–100%), A− (90–92%), B+ (87–89%), B (83–86%), B− (80–82%), C+ (77–79%), C (73–76%), C− (70–72%), D (60–69%), and F (below 60%).'
  },
  {
    question: 'Can extra credit raise my weighted grade above 100%?',
    answer: 'Yes. If your course offers bonus points or extra credit assignments, scores above 100% will raise your weighted average accordingly.'
  }
];

const webAppSchema = generateWebApplicationJsonLd({
  name: 'Grade Calculator & Final Exam Target — Count Loft',
  description: 'Calculate weighted class grades and determine the exact score needed on your final exam to earn your target letter grade.',
  url: 'https://count-loft.com/math/grade-calculator',
  category: 'WebApplication'
});
---

<ToolShell
  title="Grade Calculator"
  description="Calculate weighted course grades and determine the exact score you need on your final exam to reach your target letter grade."
  category="math"
  breadcrumbs={breadcrumbs}
  author="Count Loft Team"
  lastUpdated="2026-10-31"
>
  <div slot="inputs">
    <form id="grade-form" novalidate onsubmit="return false;">
      <h3 style="font-size: var(--text-base); margin-bottom: var(--space-3);">Course Assignments & Weights</h3>

      <div id="grade-rows-container">
        <div class="grade-row">
          <input type="text" class="form-input g-name" value="Homework" placeholder="Assignment Name" />
          <input type="number" class="form-input g-score" value="90" placeholder="Grade %" min="0" max="150" />
          <input type="number" class="form-input g-weight" value="20" placeholder="Weight %" min="0" max="100" />
          <button type="button" class="btn btn-secondary btn-sm g-del" aria-label="Delete row">×</button>
        </div>
        <div class="grade-row">
          <input type="text" class="form-input g-name" value="Midterm Exam" placeholder="Assignment Name" />
          <input type="number" class="form-input g-score" value="82" placeholder="Grade %" min="0" max="150" />
          <input type="number" class="form-input g-weight" value="30" placeholder="Weight %" min="0" max="100" />
          <button type="button" class="btn btn-secondary btn-sm g-del" aria-label="Delete row">×</button>
        </div>
        <div class="grade-row">
          <input type="text" class="form-input g-name" value="Project" placeholder="Assignment Name" />
          <input type="number" class="form-input g-score" value="95" placeholder="Grade %" min="0" max="150" />
          <input type="number" class="form-input g-weight" value="20" placeholder="Weight %" min="0" max="100" />
          <button type="button" class="btn btn-secondary btn-sm g-del" aria-label="Delete row">×</button>
        </div>
      </div>

      <button type="button" id="g-add-row-btn" class="btn btn-secondary btn-sm" style="margin-top: var(--space-2);">
        + Add Assignment
      </button>

      <div class="final-target-box">
        <h4 style="font-size: var(--text-sm); margin-bottom: var(--space-2);">Final Exam Target Planner</h4>
        <div class="form-row-2">
          <div class="form-group">
            <label for="g-target-grade" class="form-label">Desired Final Class Grade (%)</label>
            <input type="number" id="g-target-grade" class="form-input" value="90" min="0" max="100" />
          </div>
          <div class="form-group">
            <label for="g-final-weight" class="form-label">Final Exam Weight (%)</label>
            <input type="number" id="g-final-weight" class="form-input" value="30" min="1" max="99" />
          </div>
        </div>
      </div>
    </form>
  </div>

  <div slot="results">
    <div class="result-hero">
      <span class="result-hero-label">Current Weighted Grade</span>
      <span class="result-hero-value" id="g-avg-val">88.0%</span>
      <span class="result-hero-subtext" id="g-letter-val">Letter Grade: B+ (Total Weight: 70%)</span>
    </div>

    <div class="grade-target-hero">
      <span class="target-title">Required Final Exam Score</span>
      <span class="target-score" id="g-required-score">94.7%</span>
      <span class="target-sub" id="g-required-status">Achievable with preparation</span>
    </div>

    <div class="grade-breakdown-table">
      <div class="breakdown-row">
        <span>Completed Course Weight:</span>
        <strong id="g-total-weight-disp">70%</strong>
      </div>
      <div class="breakdown-row">
        <span>Desired Course Target:</span>
        <strong id="g-target-disp">90% (A-)</strong>
      </div>
      <div class="breakdown-row">
        <span>Target Score Calculation:</span>
        <strong id="g-calc-formula">[ 90 − (88 × 0.70) ] ÷ 0.30</strong>
      </div>
    </div>
  </div>

  <div slot="how-to">
    <ol>
      <li><strong>Add assignments:</strong> Input scores and syllabus weights for completed homework, quizzes, and tests.</li>
      <li><strong>Set final target:</strong> Specify the final overall grade percentage you want to achieve (e.g. 90% for A−).</li>
      <li><strong>Enter final exam weight:</strong> Input the weight of your upcoming final exam to discover the exact minimum score required.</li>
    </ol>
  </div>

  <div slot="formula">
    <pre><code>Weighted Grade = Σ (Score × Weight) ÷ Σ Weight
Required Final Score = [ Target − (Current Grade × (1 − Final Weight)) ] ÷ Final Weight</code></pre>
  </div>

  <div slot="examples-table">
    <table class="data-table">
      <thead>
        <tr>
          <th>Current Grade</th>
          <th>Desired Grade</th>
          <th>Final Exam Weight</th>
          <th>Score Needed</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>85%</td><td>90% (A-)</td><td>30%</td><td>101.7% (Extra credit needed)</td></tr>
        <tr><td>88%</td><td>90% (A-)</td><td>30%</td><td>94.7%</td></tr>
        <tr><td>92%</td><td>90% (A-)</td><td>25%</td><td>84.0%</td></tr>
        <tr><td>78%</td><td>80% (B-)</td><td>40%</td><td>83.0%</td></tr>
      </tbody>
    </table>
  </div>

  <div slot="faq">
    <FaqAccordion items={faqs} />
  </div>

  <div slot="related-tools">
    <div class="related-tools-grid">
      <a href="/math/gpa-calculator" class="card related-tool-card">
        <h3>GPA Calculator</h3>
        <p>Calculate cumulative high school and university GPA.</p>
      </a>
      <a href="/math/percentage-calculator" class="card related-tool-card">
        <h3>Percentage Calculator</h3>
        <p>Calculate test score percentages and fractional ratios.</p>
      </a>
    </div>
  </div>
</ToolShell>

<JsonLd schema={[webAppSchema, generateFaqJsonLd(faqs), generateBreadcrumbJsonLd([{ name: 'Home', item: '/' }, { name: 'Math', item: '/math' }, { name: 'Grade Calculator', item: '/math/grade-calculator' }])]} />

<style>
  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .grade-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr auto;
    gap: var(--space-2);
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .final-target-box {
    margin-top: var(--space-4);
    padding: var(--space-3);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .grade-target-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-4);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-top: var(--space-4);
    text-align: center;
  }

  .target-title {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .target-score {
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--color-primary);
    margin: var(--space-1) 0;
  }

  .target-sub {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .grade-breakdown-table {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
  }
</style>

<script>
  import { calculateWeightedGrade, calculateFinalExamRequiredScore } from '@lib/calc/grade';
  import type { GradeItem } from '@lib/calc/grade';
  import { parseNumberInput } from '@lib/format/number';

  function initGradeCalc() {
    const container = document.getElementById('grade-rows-container');
    const addBtn = document.getElementById('g-add-row-btn');
    const targetIn = document.getElementById('g-target-grade') as HTMLInputElement | null;
    const finalWeightIn = document.getElementById('g-final-weight') as HTMLInputElement | null;

    const avgDisplay = document.getElementById('g-avg-val');
    const letterDisplay = document.getElementById('g-letter-val');
    const reqScoreDisplay = document.getElementById('g-required-score');
    const reqStatusDisplay = document.getElementById('g-required-status');
    const totalWeightDisplay = document.getElementById('g-total-weight-disp');
    const targetDisplay = document.getElementById('g-target-disp');
    const formulaDisplay = document.getElementById('g-calc-formula');

    function getItems(): GradeItem[] {
      const rows = container?.querySelectorAll('.grade-row');
      const items: GradeItem[] = [];
      rows?.forEach(row => {
        const nameIn = row.querySelector('.g-name') as HTMLInputElement | null;
        const scoreIn = row.querySelector('.g-score') as HTMLInputElement | null;
        const weightIn = row.querySelector('.g-weight') as HTMLInputElement | null;

        const name = nameIn?.value || 'Assignment';
        const score = parseNumberInput(scoreIn?.value, 0);
        const weight = parseNumberInput(weightIn?.value, 0);
        items.push({ name, score, weight });
      });
      return items;
    }

    function update() {
      const items = getItems();
      const res = calculateWeightedGrade(items);

      if (avgDisplay) avgDisplay.textContent = `${res.weightedAverage}%`;
      if (letterDisplay) letterDisplay.textContent = `Letter Grade: ${res.letterGrade} (Total Weight: ${res.totalWeight}%)`;
      if (totalWeightDisplay) totalWeightDisplay.textContent = `${res.totalWeight}%`;

      const target = parseNumberInput(targetIn?.value, 90);
      const finalWeight = parseNumberInput(finalWeightIn?.value, 30);

      const targetRes = calculateFinalExamRequiredScore({
        currentGradePercent: res.weightedAverage,
        targetGradePercent: target,
        finalExamWeightPercent: finalWeight
      });

      if (reqScoreDisplay) reqScoreDisplay.textContent = `${targetRes.requiredScorePercent}%`;
      if (targetDisplay) targetDisplay.textContent = `${target}%`;

      if (reqStatusDisplay) {
        if (targetRes.status === 'already_secured') {
          reqStatusDisplay.textContent = 'Already secured! Target achieved even with 0% on final.';
        } else if (targetRes.status === 'impossible_too_high') {
          reqStatusDisplay.textContent = 'Extra credit required (Target exceeds 100% on final).';
        } else {
          reqStatusDisplay.textContent = 'Achievable with preparation.';
        }
      }

      if (formulaDisplay) {
        const currentWeightRatio = (100 - finalWeight) / 100;
        const finalWeightRatio = finalWeight / 100;
        formulaDisplay.textContent = `[ ${target} − (${res.weightedAverage} × ${currentWeightRatio.toFixed(2)}) ] ÷ ${finalWeightRatio.toFixed(2)}`;
      }
    }

    function addRow() {
      if (!container) return;
      const div = document.createElement('div');
      div.className = 'grade-row';
      div.innerHTML = `
        <input type="text" class="form-input g-name" placeholder="Assignment Name" value="Quiz / Exam" />
        <input type="number" class="form-input g-score" placeholder="Grade %" value="85" min="0" max="150" />
        <input type="number" class="form-input g-weight" placeholder="Weight %" value="10" min="0" max="100" />
        <button type="button" class="btn btn-secondary btn-sm g-del" aria-label="Delete row">×</button>
      `;
      container.appendChild(div);
      attachRowEvents(div);
      update();
    }

    function attachRowEvents(row: HTMLElement) {
      const delBtn = row.querySelector('.g-del');
      delBtn?.addEventListener('click', () => {
        if (container && container.querySelectorAll('.grade-row').length > 1) {
          row.remove();
          update();
        }
      });
      const inputs = row.querySelectorAll('input');
      inputs.forEach(i => i.addEventListener('input', update));
    }

    container?.querySelectorAll('.grade-row').forEach(r => attachRowEvents(r as HTMLElement));
    addBtn?.addEventListener('click', addRow);
    targetIn?.addEventListener('input', update);
    finalWeightIn?.addEventListener('input', update);

    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGradeCalc);
  } else {
    initGradeCalc();
  }
</script>
