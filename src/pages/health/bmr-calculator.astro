---
import ToolShell from '@components/tool/ToolShell.astro';
import FaqAccordion from '@components/tool/FaqAccordion.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { buildBreadcrumbs } from '@lib/format/breadcrumbs';
import { generateWebApplicationJsonLd, generateFaqJsonLd, generateBreadcrumbJsonLd } from '@lib/seo/jsonld';

const breadcrumbs = buildBreadcrumbs([
  { label: 'Health', href: '/health' },
  { label: 'BMR Calculator' }
]);

const faqs = [
  {
    question: 'What is Basal Metabolic Rate (BMR)?',
    answer: 'Basal Metabolic Rate is the minimum number of calories your body needs to maintain vital physiological functions—such as breathing, circulation, cell production, and nutrient processing—while completely at rest.'
  },
  {
    question: 'How is BMR different from TDEE?',
    answer: 'BMR measures your energy expenditure at complete physical rest. Total Daily Energy Expenditure (TDEE) includes your BMR plus calories burned through daily physical activity, digestion, and exercise.'
  },
  {
    question: 'Which formula does this calculator use?',
    answer: 'This calculator uses the Mifflin-St Jeor equation, widely recognized in clinical nutrition studies as the most accurate predictor of resting metabolic rate in healthy individuals.'
  },
  {
    question: 'Can you increase your BMR?',
    answer: 'Yes. Increasing lean muscle mass through resistance training elevates your resting metabolic rate because muscle tissue requires more calories to maintain at rest than adipose fat tissue.'
  },
  {
    question: 'Should I eat below my BMR to lose weight?',
    answer: 'Consuming fewer calories than your BMR for extended periods can cause nutrient deficiencies, muscle loss, and metabolic slowdown. Weight loss targets should generally remain above BMR.'
  }
];

const webAppSchema = generateWebApplicationJsonLd({
  name: 'BMR Calculator — Count Loft',
  description: 'Calculate your Basal Metabolic Rate (BMR) using the Mifflin-St Jeor equation and discover daily resting energy needs.',
  url: 'https://count-loft.com/health/bmr-calculator',
  category: 'HealthApplication'
});
---

<ToolShell
  title="BMR Calculator"
  description="Calculate your Basal Metabolic Rate (BMR) with the Mifflin-St Jeor formula to determine minimum daily calories required at rest."
  category="health"
  breadcrumbs={breadcrumbs}
  author="Count Loft Team"
  lastUpdated="2026-10-31"
>
  <div slot="inputs">
    <form id="bmr-form" novalidate onsubmit="return false;">
      <div class="form-row-2">
        <div class="form-group">
          <label for="bmr-sex" class="form-label">Biological Sex</label>
          <select id="bmr-sex" class="form-input">
            <option value="male" selected>Male</option>
            <option value="female">Female</option>
          </select>
        </div>
        <div class="form-group">
          <label for="bmr-age" class="form-label">Age (Years)</label>
          <input type="number" id="bmr-age" class="form-input" value="30" min="15" max="100" />
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="bmr-height" class="form-label">Height (cm)</label>
          <input type="number" id="bmr-height" class="form-input" value="175" min="80" max="250" />
        </div>
        <div class="form-group">
          <label for="bmr-weight" class="form-label">Weight (kg)</label>
          <input type="number" id="bmr-weight" class="form-input" value="70" min="30" max="300" step="0.5" />
        </div>
      </div>
    </form>
  </div>

  <div slot="results">
    <div class="result-hero">
      <span class="result-hero-label">Basal Metabolic Rate</span>
      <span class="result-hero-value" id="bmr-val">1,644 kcal</span>
      <span class="result-hero-subtext">Resting daily calories without activity</span>
    </div>

    <div class="bmr-activity-table">
      <h3 class="activity-title">Daily Energy Needs by Activity Level</h3>
      <div class="breakdown-row">
        <span>Sedentary (desk job, little exercise):</span>
        <strong id="bmr-sedentary">1,973 kcal</strong>
      </div>
      <div class="breakdown-row">
        <span>Light Exercise (1–3 days/week):</span>
        <strong id="bmr-light">2,261 kcal</strong>
      </div>
      <div class="breakdown-row">
        <span>Moderate Exercise (3–5 days/week):</span>
        <strong id="bmr-moderate">2,548 kcal</strong>
      </div>
      <div class="breakdown-row">
        <span>Heavy Exercise (6–7 days/week):</span>
        <strong id="bmr-active">2,836 kcal</strong>
      </div>
      <div class="breakdown-row">
        <span>Very Heavy / Athlete (2x/day):</span>
        <strong id="bmr-extreme">3,124 kcal</strong>
      </div>
    </div>
  </div>

  <div slot="how-to">
    <ol>
      <li><strong>Select biological sex and age:</strong> Metabolic equations account for sex-specific endocrine profiles and age-related basal shifts.</li>
      <li><strong>Enter height and weight:</strong> Metric measurements (cm and kg) yield highest precision.</li>
      <li><strong>Review your BMR:</strong> This baseline is the minimum energy your organs need to function.</li>
    </ol>
  </div>

  <div slot="formula">
    <pre><code>Mifflin-St Jeor Equations:
Men:   BMR = (10 × weight in kg) + (6.25 × height in cm) − (5 × age in years) + 5
Women: BMR = (10 × weight in kg) + (6.25 × height in cm) − (5 × age in years) − 161</code></pre>
  </div>

  <div slot="examples-table">
    <table class="data-table">
      <thead>
        <tr>
          <th>Profile</th>
          <th>Height / Weight</th>
          <th>Age</th>
          <th>BMR (kcal/day)</th>
          <th>TDEE (Moderate)</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>Male</td><td>175 cm / 70 kg</td><td>30</td><td>1,644 kcal</td><td>2,548 kcal</td></tr>
        <tr><td>Male</td><td>180 cm / 85 kg</td><td>40</td><td>1,780 kcal</td><td>2,759 kcal</td></tr>
        <tr><td>Female</td><td>165 cm / 58 kg</td><td>28</td><td>1,310 kcal</td><td>2,031 kcal</td></tr>
        <tr><td>Female</td><td>160 cm / 68 kg</td><td>45</td><td>1,304 kcal</td><td>2,021 kcal</td></tr>
      </tbody>
    </table>
  </div>

  <div slot="faq">
    <FaqAccordion items={faqs} />
  </div>

  <div slot="related-tools">
    <div class="related-tools-grid">
      <a href="/health/calorie-calculator" class="card related-tool-card">
        <h3>Calorie & Macro Calculator</h3>
        <p>Calculate personalized calorie deficits or surpluses for weight management.</p>
      </a>
      <a href="/health/bmi-calculator" class="card related-tool-card">
        <h3>BMI Calculator</h3>
        <p>Check adult body mass index categories and healthy weight spans.</p>
      </a>
    </div>
  </div>
</ToolShell>

<JsonLd schema={[webAppSchema, generateFaqJsonLd(faqs), generateBreadcrumbJsonLd([{ name: 'Home', item: '/' }, { name: 'Health', item: '/health' }, { name: 'BMR Calculator', item: '/health/bmr-calculator' }])]} />

<style>
  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .bmr-activity-table {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .activity-title {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-2);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
  }
</style>

<script>
  import { calculateCalories } from '@lib/calc/calorie';
  import type { BiologicalSex } from '@lib/calc/calorie';
  import { formatInteger, parseNumberInput } from '@lib/format/number';

  function initBmr() {
    const sexIn = document.getElementById('bmr-sex') as HTMLSelectElement | null;
    const ageIn = document.getElementById('bmr-age') as HTMLInputElement | null;
    const heightIn = document.getElementById('bmr-height') as HTMLInputElement | null;
    const weightIn = document.getElementById('bmr-weight') as HTMLInputElement | null;

    const bmrDisplay = document.getElementById('bmr-val');
    const sedDisplay = document.getElementById('bmr-sedentary');
    const lightDisplay = document.getElementById('bmr-light');
    const modDisplay = document.getElementById('bmr-moderate');
    const actDisplay = document.getElementById('bmr-active');
    const extDisplay = document.getElementById('bmr-extreme');

    function update() {
      const sex = (sexIn?.value as BiologicalSex) || 'male';
      const age = parseNumberInput(ageIn?.value, 30);
      const heightCm = parseNumberInput(heightIn?.value, 175);
      const weightKg = parseNumberInput(weightIn?.value, 70);

      const res = calculateCalories({
        sex,
        age,
        heightCm,
        weightKg,
        activityLevel: 'sedentary'
      });

      const bmr = res.bmr;

      if (bmrDisplay) bmrDisplay.textContent = `${formatInteger(bmr)} kcal`;
      if (sedDisplay) sedDisplay.textContent = `${formatInteger(Math.round(bmr * 1.2))} kcal`;
      if (lightDisplay) lightDisplay.textContent = `${formatInteger(Math.round(bmr * 1.375))} kcal`;
      if (modDisplay) modDisplay.textContent = `${formatInteger(Math.round(bmr * 1.55))} kcal`;
      if (actDisplay) actDisplay.textContent = `${formatInteger(Math.round(bmr * 1.725))} kcal`;
      if (extDisplay) extDisplay.textContent = `${formatInteger(Math.round(bmr * 1.9))} kcal`;
    }

    [sexIn, ageIn, heightIn, weightIn].forEach(i => {
      i?.addEventListener('input', update);
      i?.addEventListener('change', update);
    });
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBmr);
  } else {
    initBmr();
  }
</script>
