---
import ToolShell from '@components/tool/ToolShell.astro';
import FaqAccordion from '@components/tool/FaqAccordion.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { buildBreadcrumbs } from '@lib/format/breadcrumbs';
import { generateWebApplicationJsonLd, generateFaqJsonLd, generateBreadcrumbJsonLd } from '@lib/seo/jsonld';

const breadcrumbs = buildBreadcrumbs([
  { label: 'Health', href: '/health' },
  { label: 'Pregnancy Due Date Calculator' }
]);

const faqs = [
  {
    question: 'How is an estimated due date (EDD) calculated?',
    answer: 'Standard clinical dating uses Naegele’s rule: 280 days (40 weeks) are added to the first day of your last menstrual period (LMP), adjusted for cycle lengths different from 28 days.'
  },
  {
    question: 'How many babies are born on their exact due date?',
    answer: 'Only approximately 4% to 5% of babies are born on their exact estimated due date. Most full-term births occur within a two-week window before or after (37 to 42 weeks).'
  },
  {
    question: 'What are the three trimesters of pregnancy?',
    answer: 'The first trimester spans weeks 1 through 13. The second trimester spans weeks 14 through 27. The third trimester begins at week 28 and continues through delivery.'
  },
  {
    question: 'What if my menstrual cycles are irregular?',
    answer: 'If your cycles are irregular or longer/shorter than 28 days, an early first-trimester dating ultrasound (crown-rump length measurement) provides the most precise due date estimation.'
  },
  {
    question: 'Can the due date change during pregnancy?',
    answer: 'Healthcare providers may update an initial LMP due date if an early 8-to-12-week ultrasound differs by more than 5 to 7 days from the calendar calculation.'
  }
];

const webAppSchema = generateWebApplicationJsonLd({
  name: 'Pregnancy Due Date Calculator — Count Loft',
  description: 'Calculate your estimated due date, gestational age, and pregnancy trimesters using Naegele’s rule.',
  url: '/health/pregnancy-due-date-calculator',
  category: 'HealthApplication'
});
---

<ToolShell
  title="Pregnancy Due Date Calculator"
  description="Calculate your estimated due date (EDD), track current gestational age in weeks and days, and view trimester milestones."
  category="health"
  breadcrumbs={breadcrumbs}
  author="Count Loft Team"
  lastUpdated="2026-10-31"
>
  <div slot="inputs">
    <form id="preg-form" novalidate onsubmit="return false;">
      <div class="form-group">
        <label for="preg-lmp" class="form-label">First Day of Last Menstrual Period (LMP)</label>
        <input type="date" id="preg-lmp" class="form-input" />
      </div>

      <div class="form-group">
        <label for="preg-cycle" class="form-label">Average Menstrual Cycle Length (Days)</label>
        <input type="number" id="preg-cycle" class="form-input" value="28" min="20" max="45" />
      </div>
    </form>
  </div>

  <div slot="results">
    <div class="result-hero">
      <span class="result-hero-label">Estimated Due Date</span>
      <span class="result-hero-value" id="preg-due-val">—</span>
      <span class="result-hero-subtext" id="preg-remaining-val">—</span>
    </div>

    <div class="preg-milestones-table">
      <div class="breakdown-row">
        <span>Gestational Age:</span>
        <strong id="preg-age-val">—</strong>
      </div>
      <div class="breakdown-row">
        <span>Current Trimester:</span>
        <strong id="preg-trimester-val">—</strong>
      </div>
      <div class="breakdown-row">
        <span>Full Term Milestone:</span>
        <strong id="preg-term-val">37 Weeks (Safe delivery window)</strong>
      </div>
    </div>
  </div>

  <div slot="how-to">
    <ol>
      <li><strong>Select your LMP date:</strong> Choose the calendar day bleeding began during your most recent normal period.</li>
      <li><strong>Adjust your typical cycle duration:</strong> Standard cycles average 28 days; adjust if yours is typically shorter or longer.</li>
      <li><strong>Track gestational progress:</strong> See your current developmental trimester and projected delivery date.</li>
    </ol>
  </div>

  <div slot="formula">
    <pre><code>Naegele's Rule:
Estimated Due Date = LMP + 280 Days + (Cycle Length − 28 Days)
Gestational Age    = Elapsed Days from LMP ÷ 7 (Weeks + Days)</code></pre>
  </div>

  <div slot="examples-table">
    <table class="data-table">
      <thead>
        <tr>
          <th>Trimester</th>
          <th>Gestational Weeks</th>
          <th>Key Development Milestones</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>First Trimester</td><td>Weeks 1 – 13</td><td>Organogenesis, heart tube beats, limb buds form</td></tr>
        <tr><td>Second Trimester</td><td>Weeks 14 – 27</td><td>Anatomy scan, rapid skeletal growth, fetal movement felt</td></tr>
        <tr><td>Third Trimester</td><td>Weeks 28 – 40+</td><td>Lung maturation, rapid weight gain, head engagement</td></tr>
      </tbody>
    </table>
  </div>

  <div slot="faq">
    <FaqAccordion items={faqs} />
  </div>

  <div slot="related-tools">
    <div class="related-tools-grid">
      <a href="/health/ovulation-calculator" class="card related-tool-card">
        <h3>Ovulation Calculator</h3>
        <p>Predict your monthly fertile window and peak conception dates.</p>
      </a>
      <a href="/math/age-calculator" class="card related-tool-card">
        <h3>Age Calculator</h3>
        <p>Calculate exact chronological age in years, months, and days.</p>
      </a>
    </div>
  </div>
</ToolShell>

<JsonLd schema={[webAppSchema, generateFaqJsonLd(faqs), generateBreadcrumbJsonLd([{ name: 'Home', item: '/' }, { name: 'Health', item: '/health' }, { name: 'Pregnancy Due Date Calculator', item: '/health/pregnancy-due-date-calculator' }])]} />

<style>
  .preg-milestones-table {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
  }
</style>

<script>
  import { calculatePregnancyDueDate } from '@lib/calc/pregnancy';
  import { parseNumberInput } from '@lib/format/number';

  function initPregnancy() {
    const lmpIn = document.getElementById('preg-lmp') as HTMLInputElement | null;
    const cycleIn = document.getElementById('preg-cycle') as HTMLInputElement | null;

    const dueDisplay = document.getElementById('preg-due-val');
    const remainingDisplay = document.getElementById('preg-remaining-val');
    const ageDisplay = document.getElementById('preg-age-val');
    const trimDisplay = document.getElementById('preg-trimester-val');

    // Default to 8 weeks ago for interactive initial preview
    if (lmpIn && !lmpIn.value) {
      const defaultLmp = new Date();
      defaultLmp.setDate(defaultLmp.getDate() - 56);
      lmpIn.value = defaultLmp.toISOString().split('T')[0] || '';
    }

    function update() {
      const lmpStr = lmpIn?.value || '';
      const cycle = parseNumberInput(cycleIn?.value, 28);

      if (!lmpStr) return;

      const res = calculatePregnancyDueDate(lmpStr, cycle);

      if (dueDisplay) {
        const d = new Date(res.dueDate);
        dueDisplay.textContent = !isNaN(d.getTime())
          ? d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
          : res.dueDate;
      }

      if (remainingDisplay) {
        remainingDisplay.textContent = `${res.daysRemaining} days remaining`;
      }

      if (ageDisplay) {
        ageDisplay.textContent = `${res.currentWeek} Weeks, ${res.currentDay} Days`;
      }

      if (trimDisplay) {
        const ordinals = { 1: '1st Trimester', 2: '2nd Trimester', 3: '3rd Trimester' };
        trimDisplay.textContent = ordinals[res.trimester];
      }
    }

    lmpIn?.addEventListener('input', update);
    cycleIn?.addEventListener('input', update);
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPregnancy);
  } else {
    initPregnancy();
  }
</script>
