---
import ToolShell from '@components/tool/ToolShell.astro';
import FaqAccordion from '@components/tool/FaqAccordion.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { buildBreadcrumbs } from '@lib/format/breadcrumbs';
import { generateWebApplicationJsonLd, generateFaqJsonLd, generateBreadcrumbJsonLd } from '@lib/seo/jsonld';

const breadcrumbs = buildBreadcrumbs([
  { label: 'Converters', href: '/converters' },
  { label: 'Temperature Converter' }
]);

const faqs = [
  {
    question: 'How do you convert Celsius to Fahrenheit?',
    answer: 'Multiply the temperature in Celsius by 9/5 (or 1.8), then add 32: °F = (°C × 1.8) + 32.'
  },
  {
    question: 'How do you convert Fahrenheit to Celsius?',
    answer: 'Subtract 32 from the Fahrenheit temperature, then multiply by 5/9: °C = (°F − 32) × (5 ÷ 9).'
  },
  {
    question: 'What is absolute zero?',
    answer: 'Absolute zero is the theoretical point where thermodynamic system energy reaches its minimum. It is defined as 0 Kelvin, −273.15° Celsius, or −459.67° Fahrenheit.'
  },
  {
    question: 'At what temperature are Celsius and Fahrenheit equal?',
    answer: 'Celsius and Fahrenheit are equal at exactly −40 degrees (−40°C = −40°F).'
  },
  {
    question: 'Why does the Kelvin scale not use degrees?',
    answer: 'Kelvin is an absolute thermodynamic unit of measurement rather than an arbitrary scale based on water freezing/boiling, so standard scientific convention omits the degree symbol (e.g. 300 K, not 300°K).'
  }
];

const webAppSchema = generateWebApplicationJsonLd({
  name: 'Temperature Converter — Count Loft',
  description: 'Convert between Celsius (°C), Fahrenheit (°F), and Kelvin (K) temperature scales with exact formulas.',
  url: '/converters/temperature-converter',
  category: 'WebApplication'
});
---

<ToolShell
  title="Temperature Converter"
  description="Convert temperature values between Celsius (°C), Fahrenheit (°F), and Kelvin (K) with instant reciprocal formulas."
  category="converters"
  breadcrumbs={breadcrumbs}
  author="Count Loft Team"
  lastUpdated="2026-10-31"
>
  <div slot="inputs">
    <form id="temp-form" novalidate onsubmit="return false;">
      <div class="form-group">
        <label for="temp-input-val" class="form-label">Temperature Value</label>
        <input type="number" id="temp-input-val" class="form-input" value="100" step="any" />
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="temp-from-unit" class="form-label">From Scale</label>
          <select id="temp-from-unit" class="form-input">
            <option value="celsius" selected>Celsius (°C)</option>
            <option value="fahrenheit">Fahrenheit (°F)</option>
            <option value="kelvin">Kelvin (K)</option>
          </select>
        </div>
        <div class="form-group">
          <label for="temp-to-unit" class="form-label">To Scale</label>
          <select id="temp-to-unit" class="form-input">
            <option value="celsius">Celsius (°C)</option>
            <option value="fahrenheit" selected>Fahrenheit (°F)</option>
            <option value="kelvin">Kelvin (K)</option>
          </select>
        </div>
      </div>
    </form>
  </div>

  <div slot="results">
    <div class="result-hero">
      <span class="result-hero-label">Converted Temperature</span>
      <span class="result-hero-value" id="temp-result-val">212°F</span>
      <span class="result-hero-subtext" id="temp-formula-val">100°C = 212°F (Boiling point of water)</span>
    </div>

    <div class="temp-breakdown-table">
      <div class="breakdown-row">
        <span>In Celsius (°C):</span>
        <strong id="temp-c-val">100°C</strong>
      </div>
      <div class="breakdown-row">
        <span>In Fahrenheit (°F):</span>
        <strong id="temp-f-val">212°F</strong>
      </div>
      <div class="breakdown-row">
        <span>In Kelvin (K):</span>
        <strong id="temp-k-val">373.15 K</strong>
      </div>
    </div>
  </div>

  <div slot="how-to">
    <ol>
      <li><strong>Enter temperature degree:</strong> Input any positive, zero, or negative number.</li>
      <li><strong>Choose conversion scales:</strong> Select input and output units between Celsius, Fahrenheit, and Kelvin.</li>
      <li><strong>Review physical reference benchmarks:</strong> Observe the temperature relative to water freezing, body heat, and boiling points.</li>
    </ol>
  </div>

  <div slot="formula">
    <pre><code>°F = (°C × 9/5) + 32
°C = (°F − 32) × 5/9
K  = °C + 273.15
°C = K − 273.15</code></pre>
  </div>

  <div slot="examples-table">
    <table class="data-table">
      <thead>
        <tr>
          <th>Physical Phenomenon</th>
          <th>Celsius (°C)</th>
          <th>Fahrenheit (°F)</th>
          <th>Kelvin (K)</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>Absolute Zero</td><td>−273.15°C</td><td>−459.67°F</td><td>0 K</td></tr>
        <tr><td>Freezing Point of Water</td><td>0°C</td><td>32°F</td><td>273.15 K</td></tr>
        <tr><td>Normal Human Body Temp</td><td>37°C</td><td>98.6°F</td><td>310.15 K</td></tr>
        <tr><td>Boiling Point of Water</td><td>100°C</td><td>212°F</td><td>373.15 K</td></tr>
      </tbody>
    </table>
  </div>

  <div slot="faq">
    <FaqAccordion items={faqs} />
  </div>

  <div slot="related-tools">
    <div class="related-tools-grid">
      <a href="/converters/length-converter" class="card related-tool-card">
        <h3>Length Converter</h3>
        <p>Convert meters, feet, inches, kilometers, and miles.</p>
      </a>
      <a href="/converters/weight-converter" class="card related-tool-card">
        <h3>Weight Converter</h3>
        <p>Convert kilograms, pounds, ounces, grams, and stones.</p>
      </a>
    </div>
  </div>
</ToolShell>

<JsonLd schema={[webAppSchema, generateFaqJsonLd(faqs), generateBreadcrumbJsonLd([{ name: 'Home', item: '/' }, { name: 'Converters', item: '/converters' }, { name: 'Temperature Converter', item: '/converters/temperature-converter' }])]} />

<style>
  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .temp-breakdown-table {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
  }
</style>

<script>
  import { convertTemperature } from '@lib/calc/units';
  import { parseNumberInput } from '@lib/format/number';

  function initTemp() {
    const valIn = document.getElementById('temp-input-val') as HTMLInputElement | null;
    const fromIn = document.getElementById('temp-from-unit') as HTMLSelectElement | null;
    const toIn = document.getElementById('temp-to-unit') as HTMLSelectElement | null;

    const resDisplay = document.getElementById('temp-result-val');
    const formDisplay = document.getElementById('temp-formula-val');
    const cDisplay = document.getElementById('temp-c-val');
    const fDisplay = document.getElementById('temp-f-val');
    const kDisplay = document.getElementById('temp-k-val');

    type TempScale = 'celsius' | 'fahrenheit' | 'kelvin';

    function formatDeg(val: number, scale: TempScale): string {
      if (scale === 'celsius') return `${val}°C`;
      if (scale === 'fahrenheit') return `${val}°F`;
      return `${val} K`;
    }

    function update() {
      const val = parseNumberInput(valIn?.value, 100);
      const from = (fromIn?.value as TempScale) || 'celsius';
      const to = (toIn?.value as TempScale) || 'fahrenheit';

      const res = convertTemperature(val, from, to);

      if (resDisplay) resDisplay.textContent = formatDeg(res, to);
      if (formDisplay) formDisplay.textContent = `${formatDeg(val, from)} = ${formatDeg(res, to)}`;

      if (cDisplay) cDisplay.textContent = formatDeg(convertTemperature(val, from, 'celsius'), 'celsius');
      if (fDisplay) fDisplay.textContent = formatDeg(convertTemperature(val, from, 'fahrenheit'), 'fahrenheit');
      if (kDisplay) kDisplay.textContent = formatDeg(convertTemperature(val, from, 'kelvin'), 'kelvin');
    }

    [valIn, fromIn, toIn].forEach(i => {
      i?.addEventListener('input', update);
      i?.addEventListener('change', update);
    });
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTemp);
  } else {
    initTemp();
  }
</script>
