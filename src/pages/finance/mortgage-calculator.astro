---
/**
 * Count Loft — Mortgage Calculator
 * Detailed P&I, property tax, insurance, HOA, and PMI breakdown.
 */
import ToolShell from '@components/tool/ToolShell.astro';
import DonutChart from '@components/tool/DonutChart.astro';
import FaqAccordion from '@components/tool/FaqAccordion.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { buildBreadcrumbs } from '@lib/format/breadcrumbs';
import { generateWebApplicationJsonLd, generateFaqJsonLd, generateBreadcrumbJsonLd } from '@lib/seo/jsonld';

const breadcrumbs = buildBreadcrumbs([
  { label: 'Finance', href: '/finance' },
  { label: 'Mortgage Calculator' }
]);

const faqs = [
  {
    question: 'What is included in a monthly mortgage payment (PITI)?',
    answer: 'A standard mortgage payment consists of Principal (paying down the loan balance), Interest (the lender’s fee), Taxes (local property taxes held in escrow), and Insurance (homeowners hazard insurance plus private mortgage insurance if applicable).'
  },
  {
    question: 'What is Private Mortgage Insurance (PMI)?',
    answer: 'PMI is an extra insurance fee required by conventional lenders if your down payment is less than 20% of the home purchase price. It protects the lender in case of default and is typically canceled once you reach 20% equity.'
  },
  {
    question: 'How does loan term affect total interest?',
    answer: 'A 15-year mortgage has higher monthly payments than a 30-year mortgage, but significantly lower overall interest costs because the principal is paid down twice as fast at a typically lower interest rate.'
  },
  {
    question: 'How are property taxes and homeowners insurance calculated?',
    answer: 'Annual property taxes and insurance premiums are divided by 12 and placed into an escrow account monthly, from which the mortgage servicer pays the municipality and insurer annually.'
  },
  {
    question: 'Can I pay extra principal each month?',
    answer: 'Yes, most conventional mortgages have no prepayment penalty. Making additional principal payments reduces total interest and pays off your mortgage years earlier.'
  }
];

const webAppSchema = generateWebApplicationJsonLd({
  name: 'Mortgage Calculator — Count Loft',
  description: 'Calculate monthly mortgage payments (PITI) including principal, interest, taxes, insurance, and PMI with full amortization.',
  url: '/finance/mortgage-calculator',
  category: 'FinanceApplication'
});
---

<ToolShell
  title="Mortgage Calculator"
  description="Estimate total monthly mortgage payments, including principal, interest, property taxes, homeowners insurance, and private mortgage insurance (PMI)."
  category="finance"
  breadcrumbs={breadcrumbs}
  author="Count Loft Team"
  lastUpdated="2026-10-31"
>
  <div slot="inputs">
    <form id="mortgage-form" novalidate onsubmit="return false;">
      <div class="form-group">
        <label for="home-price" class="form-label">Home Price ($)</label>
        <input type="number" id="home-price" class="form-input" value="400000" step="5000" />
      </div>

      <div class="form-group">
        <label for="down-payment" class="form-label">Down Payment ($)</label>
        <input type="number" id="down-payment" class="form-input" value="80000" step="5000" />
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="mortgage-rate" class="form-label">Interest Rate (%)</label>
          <input type="number" id="mortgage-rate" class="form-input" value="6.5" step="0.1" />
        </div>
        <div class="form-group">
          <label for="mortgage-term" class="form-label">Loan Term (Years)</label>
          <select id="mortgage-term" class="form-select">
            <option value="15">15 Years</option>
            <option value="20">20 Years</option>
            <option value="30" selected>30 Years</option>
          </select>
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="property-tax" class="form-label">Property Tax ($/yr)</label>
          <input type="number" id="property-tax" class="form-input" value="4800" step="100" />
        </div>
        <div class="form-group">
          <label for="home-insurance" class="form-label">Home Insurance ($/yr)</label>
          <input type="number" id="home-insurance" class="form-input" value="1200" step="100" />
        </div>
      </div>

      <div class="form-group">
        <label for="monthly-hoa" class="form-label">Monthly HOA Fees ($)</label>
        <input type="number" id="monthly-hoa" class="form-input" value="0" step="25" />
      </div>
    </form>
  </div>

  <div slot="results">
    <div class="result-hero" id="mortgage-hero-box">
      <span class="result-hero-label">Total Monthly Payment</span>
      <span class="result-hero-value" id="mortgage-total-payment">$2,523</span>
      <span class="result-hero-subtext">Principal, Interest, Taxes & Insurance</span>
    </div>

    <div class="mortgage-breakdown-table">
      <div class="breakdown-row">
        <span>Principal & Interest:</span>
        <strong id="pi-payment">$2,023</strong>
      </div>
      <div class="breakdown-row">
        <span>Property Taxes:</span>
        <strong id="tax-payment">$400</strong>
      </div>
      <div class="breakdown-row">
        <span>Home Insurance:</span>
        <strong id="ins-payment">$100</strong>
      </div>
      <div class="breakdown-row">
        <span>PMI:</span>
        <strong id="pmi-payment">$0</strong>
      </div>
    </div>

    <div class="chart-wrapper">
      <DonutChart
        title="Payment Breakdown"
        segments={[
          { label: 'P&I', value: 2023, color: 'var(--color-primary)' },
          { label: 'Taxes', value: 400, color: 'var(--color-secondary)' },
          { label: 'Insurance', value: 100, color: 'var(--color-warning)' }
        ]}
      />
    </div>
  </div>

  <div slot="how-to">
    <ol>
      <li><strong>Enter purchase price & down payment:</strong> Providing at least 20% down avoids PMI fees.</li>
      <li><strong>Input interest rate & term:</strong> Select standard 15-year or 30-year fixed terms.</li>
      <li><strong>Include escrow taxes & insurance:</strong> Local property taxes and insurance vary by county and state.</li>
    </ol>
  </div>

  <div slot="formula">
    <pre><code>Monthly P&I = L × [r(1 + r)ⁿ] / [(1 + r)ⁿ - 1]
Total Payment = P&I + (Annual Tax ÷ 12) + (Insurance ÷ 12) + PMI + HOA</code></pre>
  </div>

  <div slot="examples-table">
    <table class="data-table">
      <thead>
        <tr>
          <th>Home Price</th>
          <th>Down Payment (20%)</th>
          <th>Loan Amount</th>
          <th>Monthly P&I (6.5%)</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>$250,000</td><td>$50,000</td><td>$200,000</td><td>$1,264 / mo</td></tr>
        <tr><td>$350,000</td><td>$70,000</td><td>$280,000</td><td>$1,770 / mo</td></tr>
        <tr><td>$450,000</td><td>$90,000</td><td>$360,000</td><td>$2,275 / mo</td></tr>
        <tr><td>$600,000</td><td>$120,000</td><td>$480,000</td><td>$3,034 / mo</td></tr>
      </tbody>
    </table>
  </div>

  <div slot="faq">
    <FaqAccordion items={faqs} />
  </div>

  <div slot="related-tools">
    <div class="related-tools-grid">
      <a href="/finance/loan-calculator" class="card related-tool-card">
        <h3>Loan / EMI Calculator</h3>
        <p>Calculate auto, personal, or general consumer loan payments.</p>
      </a>
      <a href="/finance/amortization-calculator" class="card related-tool-card">
        <h3>Amortization Calculator</h3>
        <p>View full printable amortization schedules and payment graphs.</p>
      </a>
    </div>
  </div>
</ToolShell>

<JsonLd schema={[webAppSchema, generateFaqJsonLd(faqs), generateBreadcrumbJsonLd([{ name: 'Home', item: '/' }, { name: 'Finance', item: '/finance' }, { name: 'Mortgage Calculator', item: '/finance/mortgage-calculator' }])]} />

<style>
  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .mortgage-breakdown-table {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
  }
</style>

<script>
  import { calculateMortgage } from '@lib/calc/mortgage';
  import { formatCurrency, parseNumberInput } from '@lib/format/number';

  function initMortgage() {
    const priceIn = document.getElementById('home-price') as HTMLInputElement | null;
    const downIn = document.getElementById('down-payment') as HTMLInputElement | null;
    const rateIn = document.getElementById('mortgage-rate') as HTMLInputElement | null;
    const termIn = document.getElementById('mortgage-term') as HTMLSelectElement | null;
    const taxIn = document.getElementById('property-tax') as HTMLInputElement | null;
    const insIn = document.getElementById('home-insurance') as HTMLInputElement | null;
    const hoaIn = document.getElementById('monthly-hoa') as HTMLInputElement | null;

    const totalDisplay = document.getElementById('mortgage-total-payment');
    const piDisplay = document.getElementById('pi-payment');
    const taxDisplay = document.getElementById('tax-payment');
    const insDisplay = document.getElementById('ins-payment');
    const pmiDisplay = document.getElementById('pmi-payment');

    function update() {
      const res = calculateMortgage({
        homePrice: parseNumberInput(priceIn?.value, 400000),
        downPayment: parseNumberInput(downIn?.value, 80000),
        annualInterestRate: parseNumberInput(rateIn?.value, 6.5),
        loanTermYears: parseNumberInput(termIn?.value, 30),
        annualPropertyTax: parseNumberInput(taxIn?.value, 4800),
        annualHomeInsurance: parseNumberInput(insIn?.value, 1200),
        monthlyHoa: parseNumberInput(hoaIn?.value, 0)
      });

      if (totalDisplay) totalDisplay.textContent = formatCurrency(res.totalMonthlyPayment);
      if (piDisplay) piDisplay.textContent = formatCurrency(res.monthlyPrincipalInterest);
      if (taxDisplay) taxDisplay.textContent = formatCurrency(res.monthlyPropertyTax);
      if (insDisplay) insDisplay.textContent = formatCurrency(res.monthlyHomeInsurance);
      if (pmiDisplay) pmiDisplay.textContent = formatCurrency(res.monthlyPmi);
    }

    [priceIn, downIn, rateIn, termIn, taxIn, insIn, hoaIn].forEach(i => i?.addEventListener('input', update));
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMortgage);
  } else {
    initMortgage();
  }
</script>
