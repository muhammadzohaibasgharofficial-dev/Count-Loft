---
import ToolShell from '@components/tool/ToolShell.astro';
import FaqAccordion from '@components/tool/FaqAccordion.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { buildBreadcrumbs } from '@lib/format/breadcrumbs';
import { generateWebApplicationJsonLd, generateFaqJsonLd, generateBreadcrumbJsonLd } from '@lib/seo/jsonld';

const breadcrumbs = buildBreadcrumbs([
  { label: 'Finance', href: '/finance' },
  { label: 'Amortization Calculator' }
]);

const faqs = [
  {
    question: 'What is loan amortization?',
    answer: 'Amortization is the process of spreading out a loan into a series of equal periodic payments. Over time, a larger portion of each payment goes toward the principal balance and less toward interest.'
  },
  {
    question: 'Why does early interest dominate loan payments?',
    answer: 'Because interest is calculated on the remaining unpaid principal balance. In the initial years, the principal is highest, so the interest charge is largest.'
  },
  {
    question: 'How do extra payments impact an amortization schedule?',
    answer: 'Making additional payments directly to the principal reduces the remaining balance immediately. This shortens the loan term and saves substantial interest over the life of the loan.'
  },
  {
    question: 'What is the difference between an amortization schedule and a loan statement?',
    answer: 'An amortization schedule projects all future payments assuming steady interest and timely payments. A loan statement shows actual historical transactions and current balance.'
  },
  {
    question: 'Can I amortize both fixed and variable loans?',
    answer: 'A fixed-rate amortization schedule is fully predictable. Variable-rate loans recalculate their schedule whenever the benchmark interest rate changes.'
  }
];

const webAppSchema = generateWebApplicationJsonLd({
  name: 'Amortization Calculator — Count Loft',
  description: 'Generate complete month-by-month and year-by-year loan amortization schedules with principal and interest breakdowns.',
  url: '/finance/amortization-calculator',
  category: 'FinanceApplication'
});
---

<ToolShell
  title="Amortization Calculator"
  description="Generate a complete month-by-month loan amortization schedule, track remaining principal, and visualize interest payoff over time."
  category="finance"
  breadcrumbs={breadcrumbs}
  author="Count Loft Team"
  lastUpdated="2026-10-31"
>
  <div slot="inputs">
    <form id="amort-form" novalidate onsubmit="return false;">
      <div class="form-group">
        <label for="amort-principal" class="form-label">Loan Amount ($)</label>
        <input type="number" id="amort-principal" class="form-input" value="200000" min="1000" step="5000" />
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="amort-rate" class="form-label">Annual Interest Rate (%)</label>
          <input type="number" id="amort-rate" class="form-input" value="6.5" min="0.1" max="30" step="0.1" />
        </div>
        <div class="form-group">
          <label for="amort-term-years" class="form-label">Loan Term (Years)</label>
          <input type="number" id="amort-term-years" class="form-input" value="15" min="1" max="40" />
        </div>
      </div>
    </form>
  </div>

  <div slot="results">
    <div class="result-hero">
      <span class="result-hero-label">Monthly Payment (P&I)</span>
      <span class="result-hero-value" id="amort-monthly-val">$1,742.22</span>
      <span class="result-hero-subtext" id="amort-total-interest">Total Interest: $113,600.08</span>
    </div>

    <div class="amort-summary-table">
      <div class="breakdown-row">
        <span>Total Loan Payments:</span>
        <strong id="amort-total-payments">$313,600.08</strong>
      </div>
      <div class="breakdown-row">
        <span>Principal Amount:</span>
        <strong id="amort-principal-disp">$200,000.00</strong>
      </div>
      <div class="breakdown-row">
        <span>Payoff Date (From Today):</span>
        <strong id="amort-payoff-date">October 2041</strong>
      </div>
    </div>

    <div class="schedule-preview">
      <h3 class="schedule-title">First 12 Months Amortization Preview</h3>
      <div class="table-container">
        <table class="data-table" id="amort-schedule-table">
          <thead>
            <tr>
              <th>Month</th>
              <th>Payment</th>
              <th>Principal</th>
              <th>Interest</th>
              <th>Remaining Balance</th>
            </tr>
          </thead>
          <tbody id="amort-schedule-tbody">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div slot="how-to">
    <ol>
      <li><strong>Enter loan principal:</strong> Specify the total amount financed.</li>
      <li><strong>Input interest rate and term:</strong> Define annual percentage rate (APR) and repayment years.</li>
      <li><strong>Analyze the schedule:</strong> Review how each payment allocates between interest charges and principal equity.</li>
    </ol>
  </div>

  <div slot="formula">
    <pre><code>Monthly Payment (M) = P × [ r(1 + r)^n ] ÷ [ (1 + r)^n − 1 ]
Interest Portion    = Remaining Balance × r
Principal Portion   = M − Interest Portion
New Balance         = Prior Balance − Principal Portion</code></pre>
  </div>

  <div slot="examples-table">
    <table class="data-table">
      <thead>
        <tr>
          <th>Loan Amount</th>
          <th>Rate</th>
          <th>Term</th>
          <th>Monthly Payment</th>
          <th>Total Interest</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>$100,000</td><td>6.0%</td><td>15 Years</td><td>$843.86</td><td>$51,894.27</td></tr>
        <tr><td>$200,000</td><td>6.5%</td><td>15 Years</td><td>$1,742.22</td><td>$113,600.08</td></tr>
        <tr><td>$300,000</td><td>6.5%</td><td>30 Years</td><td>$1,896.20</td><td>$382,633.47</td></tr>
        <tr><td>$500,000</td><td>7.0%</td><td>30 Years</td><td>$3,326.51</td><td>$697,544.40</td></tr>
      </tbody>
    </table>
  </div>

  <div slot="faq">
    <FaqAccordion items={faqs} />
  </div>

  <div slot="related-tools">
    <div class="related-tools-grid">
      <a href="/finance/loan-calculator" class="card related-tool-card">
        <h3>Loan Calculator</h3>
        <p>Calculate payments and interest for auto, personal, and installment loans.</p>
      </a>
      <a href="/finance/mortgage-calculator" class="card related-tool-card">
        <h3>Mortgage Calculator</h3>
        <p>Estimate complete home financing costs including taxes and insurance.</p>
      </a>
    </div>
  </div>
</ToolShell>

<JsonLd schema={[webAppSchema, generateFaqJsonLd(faqs), generateBreadcrumbJsonLd([{ name: 'Home', item: '/' }, { name: 'Finance', item: '/finance' }, { name: 'Amortization Calculator', item: '/finance/amortization-calculator' }])]} />

<style>
  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .amort-summary-table {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
  }

  .schedule-preview {
    margin-top: var(--space-6);
  }

  .schedule-title {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-3);
  }

  .table-container {
    overflow-x: auto;
    max-height: 380px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
</style>

<script>
  import { calculateLoan } from '@lib/calc/loan';
  import { formatCurrency, parseNumberInput } from '@lib/format/number';

  function initAmortization() {
    const principalIn = document.getElementById('amort-principal') as HTMLInputElement | null;
    const rateIn = document.getElementById('amort-rate') as HTMLInputElement | null;
    const yearsIn = document.getElementById('amort-term-years') as HTMLInputElement | null;

    const monthlyDisplay = document.getElementById('amort-monthly-val');
    const totalInterestDisplay = document.getElementById('amort-total-interest');
    const totalPaymentsDisplay = document.getElementById('amort-total-payments');
    const principalDisplay = document.getElementById('amort-principal-disp');
    const payoffDisplay = document.getElementById('amort-payoff-date');
    const scheduleTbody = document.getElementById('amort-schedule-tbody');

    function update() {
      const principal = parseNumberInput(principalIn?.value, 200000);
      const rate = parseNumberInput(rateIn?.value, 6.5);
      const years = parseNumberInput(yearsIn?.value, 15);
      const termMonths = Math.max(1, Math.round(years * 12));

      const res = calculateLoan({ principal, annualRate: rate, termMonths }, true);

      if (monthlyDisplay) monthlyDisplay.textContent = formatCurrency(res.monthlyPayment);
      if (totalInterestDisplay) totalInterestDisplay.textContent = `Total Interest: ${formatCurrency(res.totalInterest)}`;
      if (totalPaymentsDisplay) totalPaymentsDisplay.textContent = formatCurrency(res.totalPayment);
      if (principalDisplay) principalDisplay.textContent = formatCurrency(principal);

      const now = new Date();
      now.setMonth(now.getMonth() + termMonths);
      const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
      if (payoffDisplay) payoffDisplay.textContent = `${monthNames[now.getMonth()]} ${now.getFullYear()}`;

      if (scheduleTbody && res.schedule) {
        // Render first 12 months preview
        const previewRows = res.schedule.slice(0, 12);
        scheduleTbody.innerHTML = previewRows.map(row => `
          <tr>
            <td>${row.month}</td>
            <td>${formatCurrency(row.payment)}</td>
            <td>${formatCurrency(row.principalPayment)}</td>
            <td>${formatCurrency(row.interestPayment)}</td>
            <td>${formatCurrency(row.remainingBalance)}</td>
          </tr>
        `).join('');
      }
    }

    [principalIn, rateIn, yearsIn].forEach(i => i?.addEventListener('input', update));
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAmortization);
  } else {
    initAmortization();
  }
</script>
