---
/**
 * Count Loft — Loan / EMI Calculator (Reference Implementation)
 * Meets all 8 sections in PRD Section 6.1 and passes Section 8 test vector.
 */
import ToolShell from '@components/tool/ToolShell.astro';
import LoanCalculatorInteractive from '@components/tool/LoanCalculatorInteractive.astro';
import FaqAccordion from '@components/tool/FaqAccordion.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { buildBreadcrumbs } from '@lib/format/breadcrumbs';
import {
  generateWebApplicationJsonLd,
  generateFaqJsonLd,
  generateBreadcrumbJsonLd
} from '@lib/seo/jsonld';

const breadcrumbs = buildBreadcrumbs([
  { label: 'Finance', href: '/finance' },
  { label: 'Loan / EMI Calculator' }
]);

const faqs = [
  {
    question: 'How is an amortized monthly loan payment (EMI) calculated?',
    answer: 'Monthly loan payments are computed using standard amortization: P = L * [r(1+r)^n] / [(1+r)^n - 1], where L is the principal amount borrowed, r is the monthly interest rate (annual interest divided by 12), and n is the total number of monthly payments.'
  },
  {
    question: 'What is the difference between an EMI and simple interest?',
    answer: 'An Equated Monthly Installment (EMI) amortizes principal and compounding interest evenly over the term, meaning early payments pay mostly interest while later payments pay off principal. Simple interest charges interest solely on the original principal without compounding.'
  },
  {
    question: 'Does paying off a loan early reduce the total interest paid?',
    answer: 'Yes. In an amortized loan, interest is calculated each month on the remaining unpaid principal balance. Making extra principal payments lowers the outstanding balance and saves total interest over the life of the loan.'
  },
  {
    question: 'Can this calculator be used for auto loans or personal loans?',
    answer: 'Yes. Most fixed-rate personal loans, auto loans, and standard mortgages use this exact fixed-rate amortization formula.'
  },
  {
    question: 'What happens if the interest rate is 0%?',
    answer: 'When the interest rate is 0%, no interest charges accrue. The monthly payment is simply the total principal divided evenly by the total number of months.'
  }
];

const webAppSchema = generateWebApplicationJsonLd({
  name: 'Loan / EMI Calculator — Count Loft',
  description: 'Calculate monthly loan payments (EMI), total interest charges, and view full amortization schedule.',
  url: '/finance/loan-calculator',
  category: 'FinanceApplication'
});

const faqSchema = generateFaqJsonLd(faqs);
const breadcrumbSchema = generateBreadcrumbJsonLd([
  { name: 'Home', item: '/' },
  { name: 'Finance', item: '/finance' },
  { name: 'Loan / EMI Calculator', item: '/finance/loan-calculator' }
]);
---

<ToolShell
  title="Loan / EMI Calculator"
  description="Calculate monthly payments (EMI), total interest charges, and view a detailed amortization schedule for auto, personal, or consumer loans."
  category="finance"
  breadcrumbs={breadcrumbs}
  author="Count Loft Team"
  lastUpdated="2026-10-31"
>
  <!-- Interactive Calculator Island -->
  <div slot="inputs">
    <LoanCalculatorInteractive />
  </div>

  <!-- Section 4: How-to Steps -->
  <div slot="how-to">
    <ol class="steps-list">
      <li><strong>Enter the Loan Amount:</strong> Input the total amount borrowed or financed.</li>
      <li><strong>Enter the Annual Interest Rate:</strong> Provide the fixed annual percentage rate (APR).</li>
      <li><strong>Select the Loan Term:</strong> Choose the duration in months (e.g. 48) or switch to years.</li>
      <li><strong>Review Results Instantly:</strong> The monthly payment, total interest, and total cost recalculate as you type.</li>
      <li><strong>Inspect the Schedule:</strong> Open the amortization schedule table below the calculator to see principal versus interest for each month.</li>
    </ol>
  </div>

  <!-- Section 5: Formula and Calculation Steps -->
  <div slot="formula">
    <div class="formula-card">
      <p>The standard monthly installment formula is:</p>
      <pre><code>P = L × [r(1 + r)ⁿ] / [(1 + r)ⁿ - 1]</code></pre>
      <p>Where:</p>
      <ul>
        <li><code>P</code> = Monthly Payment (EMI)</li>
        <li><code>L</code> = Principal loan amount</li>
        <li><code>r</code> = Monthly interest rate (Annual rate ÷ 12 ÷ 100)</li>
        <li><code>n</code> = Total number of monthly payments</li>
      </ul>
      <h3>Worked Example:</h3>
      <p>For a loan of <strong>$20,000</strong> at <strong>6.0% annual interest</strong> over <strong>48 months</strong>:</p>
      <ul>
        <li>Monthly rate: <code>r = 6 / 12 / 100 = 0.005</code></li>
        <li>Factor: <code>(1 + 0.005)⁴⁸ ≈ 1.270489</code></li>
        <li>Monthly Payment: <code>$20,000 × [0.005 × 1.270489] / [1.270489 - 1] = $469.70</code></li>
        <li>Total Payment: <code>$469.70 × 48 = $22,545.60</code></li>
        <li>Total Interest: <code>$22,545.60 - $20,000 = $2,545.60</code></li>
      </ul>
    </div>
  </div>

  <!-- Section 6: Worked Examples and Lookup Table -->
  <div slot="examples-table">
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Loan Amount</th>
            <th scope="col">Interest Rate</th>
            <th scope="col">36 Months</th>
            <th scope="col">48 Months</th>
            <th scope="col">60 Months</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>$10,000</td>
            <td>6.0%</td>
            <td>$304.22 / mo</td>
            <td>$234.85 / mo</td>
            <td>$193.33 / mo</td>
          </tr>
          <tr>
            <td>$20,000</td>
            <td>6.0%</td>
            <td>$608.44 / mo</td>
            <td>$469.70 / mo</td>
            <td>$386.66 / mo</td>
          </tr>
          <tr>
            <td>$35,000</td>
            <td>6.0%</td>
            <td>$1,064.77 / mo</td>
            <td>$821.98 / mo</td>
            <td>$676.65 / mo</td>
          </tr>
          <tr>
            <td>$50,000</td>
            <td>6.0%</td>
            <td>$1,521.10 / mo</td>
            <td>$1,174.25 / mo</td>
            <td>$966.64 / mo</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Section 7: FAQ -->
  <div slot="faq">
    <FaqAccordion items={faqs} />
  </div>

  <!-- Section 8: Related Tools -->
  <div slot="related-tools">
    <div class="related-tools-grid">
      <a href="/finance/mortgage-calculator" class="card related-tool-card">
        <h3>Mortgage Calculator</h3>
        <p>Calculate home mortgage payments with taxes, insurance, and PMI.</p>
      </a>
      <a href="/finance/compound-interest-calculator" class="card related-tool-card">
        <h3>Compound Interest Calculator</h3>
        <p>Project long-term compound growth with regular monthly contributions.</p>
      </a>
      <a href="/finance/interest-calculator" class="card related-tool-card">
        <h3>Interest Calculator</h3>
        <p>Compare simple and compound interest returns across custom terms.</p>
      </a>
      <a href="/finance/salary-to-hourly-calculator" class="card related-tool-card">
        <h3>Salary to Hourly Calculator</h3>
        <p>Convert annual salary to hourly wage and biweekly paychecks.</p>
      </a>
    </div>
  </div>
</ToolShell>

<JsonLd schema={[webAppSchema, faqSchema, breadcrumbSchema]} />

<style>
  .steps-list {
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .formula-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .formula-card pre {
    background-color: var(--color-surface-muted);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    overflow-x: auto;
    font-size: var(--text-sm);
  }

  .table-responsive {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    margin-top: var(--space-3);
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    text-align: right;
  }

  .data-table th:first-child,
  .data-table td:first-child {
    text-align: left;
  }

  .data-table th {
    background-color: var(--color-surface-muted);
    font-weight: var(--font-weight-semibold);
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  @media (min-width: 768px) {
    .related-tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .related-tool-card {
    padding: var(--space-4);
    text-decoration: none;
    color: var(--color-text);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .related-tool-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .related-tool-card h3 {
    font-size: var(--text-body);
    margin: 0 0 var(--space-1) 0;
    color: var(--color-link);
  }

  .related-tool-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
