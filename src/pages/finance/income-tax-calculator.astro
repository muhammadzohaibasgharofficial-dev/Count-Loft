---
import ToolShell from '@components/tool/ToolShell.astro';
import FaqAccordion from '@components/tool/FaqAccordion.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { buildBreadcrumbs } from '@lib/format/breadcrumbs';
import { generateWebApplicationJsonLd, generateFaqJsonLd, generateBreadcrumbJsonLd } from '@lib/seo/jsonld';

const breadcrumbs = buildBreadcrumbs([
  { label: 'Finance', href: '/finance' },
  { label: 'Income Tax Calculator' }
]);

const faqs = [
  {
    question: 'How do progressive tax brackets work?',
    answer: 'In a progressive tax system, your income is taxed in chunks or "brackets". Only the portion of your income that falls into each bracket is taxed at that bracket rate, not your entire income.'
  },
  {
    question: 'What is the standard deduction?',
    answer: 'The standard deduction is a specific dollar amount that reduces your adjusted gross income before federal income tax is calculated. For 2026, the standard deduction is $15,000 for single filers and $30,000 for married couples filing jointly.'
  },
  {
    question: 'What is FICA tax?',
    answer: 'FICA stands for the Federal Insurance Contributions Act. It includes Social Security tax (6.2% on earnings up to $176,100) and Medicare tax (1.45% on all earnings) for wage earners.'
  },
  {
    question: 'What is the difference between marginal and effective tax rate?',
    answer: 'Your marginal tax rate is the rate paid on your last dollar of income. Your effective tax rate is the actual percentage of your total gross income paid in taxes (Total Tax ÷ Gross Income).'
  },
  {
    question: 'Does this calculator include state income taxes?',
    answer: 'This tool models federal income tax and standard FICA payroll deductions. State and local taxes vary by jurisdiction and are not included in this federal baseline.'
  }
];

const webAppSchema = generateWebApplicationJsonLd({
  name: 'Income Tax Calculator — Count Loft',
  description: 'Calculate federal income tax, FICA deductions, effective tax rate, and take-home pay.',
  url: '/finance/income-tax-calculator',
  category: 'FinanceApplication'
});
---

<ToolShell
  title="Income Tax Calculator"
  description="Estimate your federal income tax, FICA payroll withholdings, effective tax rate, and net take-home salary."
  category="finance"
  breadcrumbs={breadcrumbs}
  author="Count Loft Team"
  lastUpdated="2026-10-31"
>
  <div slot="inputs">
    <form id="tax-form" novalidate onsubmit="return false;">
      <div class="form-group">
        <label for="tax-gross-income" class="form-label">Gross Annual Income ($)</label>
        <input type="number" id="tax-gross-income" class="form-input" value="75000" min="0" step="1000" />
      </div>

      <div class="form-group">
        <label for="tax-filing-status" class="form-label">Filing Status</label>
        <select id="tax-filing-status" class="form-input">
          <option value="single" selected>Single</option>
          <option value="married_joint">Married Filing Jointly</option>
        </select>
      </div>
    </form>
  </div>

  <div slot="results">
    <div class="result-hero">
      <span class="result-hero-label">Estimated Net Take-Home Pay</span>
      <span class="result-hero-value" id="tax-takehome-val">$60,948</span>
      <span class="result-hero-subtext" id="tax-monthly-takehome">Monthly: $5,079</span>
    </div>

    <div class="tax-breakdown-table">
      <div class="breakdown-row">
        <span>Standard Deduction:</span>
        <strong id="tax-deduction-val">$15,000</strong>
      </div>
      <div class="breakdown-row">
        <span>Taxable Income:</span>
        <strong id="tax-taxable-val">$60,000</strong>
      </div>
      <div class="breakdown-row">
        <span>Federal Income Tax:</span>
        <strong id="tax-federal-val">$8,314</strong>
      </div>
      <div class="breakdown-row">
        <span>FICA (Social Security & Medicare):</span>
        <strong id="tax-fica-val">$5,738</strong>
      </div>
      <div class="breakdown-row">
        <span>Total Tax Withheld:</span>
        <strong id="tax-total-val">$14,052</strong>
      </div>
      <div class="breakdown-row">
        <span>Effective Tax Rate:</span>
        <strong id="tax-rate-val">18.7%</strong>
      </div>
    </div>
  </div>

  <div slot="how-to">
    <ol>
      <li><strong>Enter your gross annual income:</strong> Input total pre-tax salary, wages, and taxable compensation.</li>
      <li><strong>Select your filing status:</strong> Choose Single or Married Filing Jointly to apply the appropriate standard deduction and bracket thresholds.</li>
      <li><strong>Review your breakdown:</strong> Inspect federal income tax, mandatory FICA withholdings, and your net take-home salary.</li>
    </ol>
  </div>

  <div slot="formula">
    <pre><code>Taxable Income   = Max(0, Gross Income − Standard Deduction)
Total Federal Tax = Σ (Taxable Income in Bracket × Bracket Rate)
FICA Tax          = Min(Gross, Cap) × 6.2% + Gross × 1.45%
Net Take-Home     = Gross Income − (Federal Tax + FICA)</code></pre>
  </div>

  <div slot="examples-table">
    <table class="data-table">
      <thead>
        <tr>
          <th>Gross Income (Single)</th>
          <th>Standard Deduction</th>
          <th>Federal Tax</th>
          <th>Effective Rate</th>
          <th>Net Annual Pay</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>$50,000</td><td>$15,000</td><td>$3,962</td><td>15.5%</td><td>$42,213</td></tr>
        <tr><td>$75,000</td><td>$15,000</td><td>$8,314</td><td>18.7%</td><td>$60,948</td></tr>
        <tr><td>$100,000</td><td>$15,000</td><td>$13,814</td><td>21.5%</td><td>$78,536</td></tr>
        <tr><td>$150,000</td><td>$15,000</td><td>$25,372</td><td>24.7%</td><td>$113,153</td></tr>
      </tbody>
    </table>
  </div>

  <div slot="faq">
    <FaqAccordion items={faqs} />
  </div>

  <div slot="related-tools">
    <div class="related-tools-grid">
      <a href="/finance/salary-to-hourly-calculator" class="card related-tool-card">
        <h3>Salary to Hourly Calculator</h3>
        <p>Convert your annual salary into exact hourly, weekly, and daily equivalents.</p>
      </a>
      <a href="/finance/retirement-calculator" class="card related-tool-card">
        <h3>Retirement Calculator</h3>
        <p>Plan your long-term savings target using the 4% safe withdrawal rule.</p>
      </a>
    </div>
  </div>
</ToolShell>

<JsonLd schema={[webAppSchema, generateFaqJsonLd(faqs), generateBreadcrumbJsonLd([{ name: 'Home', item: '/' }, { name: 'Finance', item: '/finance' }, { name: 'Income Tax Calculator', item: '/finance/income-tax-calculator' }])]} />

<style>
  .tax-breakdown-table {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
  }
</style>

<script>
  import { calculateIncomeTax } from '@lib/calc/income-tax';
  import type { FilingStatus } from '@lib/calc/income-tax';
  import { formatCurrency, parseNumberInput } from '@lib/format/number';

  function initIncomeTax() {
    const grossIn = document.getElementById('tax-gross-income') as HTMLInputElement | null;
    const statusIn = document.getElementById('tax-filing-status') as HTMLSelectElement | null;

    const takehomeDisplay = document.getElementById('tax-takehome-val');
    const monthlyDisplay = document.getElementById('tax-monthly-takehome');
    const deductionDisplay = document.getElementById('tax-deduction-val');
    const taxableDisplay = document.getElementById('tax-taxable-val');
    const fedDisplay = document.getElementById('tax-federal-val');
    const ficaDisplay = document.getElementById('tax-fica-val');
    const totalDisplay = document.getElementById('tax-total-val');
    const rateDisplay = document.getElementById('tax-rate-val');

    function update() {
      const gross = parseNumberInput(grossIn?.value, 75000);
      const status = (statusIn?.value as FilingStatus) || 'single';

      const res = calculateIncomeTax(gross, status);

      if (takehomeDisplay) takehomeDisplay.textContent = formatCurrency(res.netTakeHome);
      if (monthlyDisplay) monthlyDisplay.textContent = `Monthly: ${formatCurrency(Math.round(res.netTakeHome / 12))}`;
      if (deductionDisplay) deductionDisplay.textContent = formatCurrency(res.standardDeduction);
      if (taxableDisplay) taxableDisplay.textContent = formatCurrency(res.taxableIncome);
      if (fedDisplay) fedDisplay.textContent = formatCurrency(res.federalTax);
      if (ficaDisplay) ficaDisplay.textContent = formatCurrency(res.ficaTax);
      if (totalDisplay) totalDisplay.textContent = formatCurrency(res.totalTax);
      if (rateDisplay) rateDisplay.textContent = `${res.effectiveTaxRate}%`;
    }

    grossIn?.addEventListener('input', update);
    statusIn?.addEventListener('change', update);
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initIncomeTax);
  } else {
    initIncomeTax();
  }
</script>
