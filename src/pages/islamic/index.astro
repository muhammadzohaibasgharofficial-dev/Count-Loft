---
import CategoryHub from '@components/layout/CategoryHub.astro';
import { CALCULATORS } from '@data/calculators';

const tools = CALCULATORS.filter(c => c.category === 'islamic');
---

<CategoryHub
  categoryName="Islamic"
  categorySlug="islamic"
  description="Calculate annual Zakat obligations across gold, silver, and liquid savings, verify Nisab thresholds, and convert Hijri dates."
  tools={tools}
/>
