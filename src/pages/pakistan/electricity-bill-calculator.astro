---
import ToolShell from '@components/tool/ToolShell.astro';
import FaqAccordion from '@components/tool/FaqAccordion.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import { buildBreadcrumbs } from '@lib/format/breadcrumbs';
import { generateWebApplicationJsonLd, generateFaqJsonLd, generateBreadcrumbJsonLd } from '@lib/seo/jsonld';
import tariffData from '@data/pk-electricity-tariffs.json';

const breadcrumbs = buildBreadcrumbs([
  { label: 'Pakistan', href: '/pakistan' },
  { label: 'Electricity Bill Calculator' }
]);

const faqs = [
  {
    question: 'How are residential electricity bills calculated in Pakistan?',
    answer: 'NEPRA enforces a uniform nationwide residential tariff across all DISCOs. Your bill consists of base energy charges calculated via progressive slabs, monthly Fuel Price Adjustments (FPA), 1.5% Electricity Duty, Rs. 35 PTV fee, and 18% GST (if consumption exceeds 200 units).'
  },
  {
    question: 'What is a "Protected Consumer" in Pakistan electricity?',
    answer: 'A residential consumer is classified as protected if their monthly consumption has remained under 200 units for the preceding six consecutive months. Protected consumers enjoy subsidized lifeline base tariffs.'
  },
  {
    question: 'What is Fuel Price Adjustment (FPA)?',
    answer: 'FPA is a variable monthly surcharge determined by NEPRA reflecting variations in actual crude, coal, and RLNG fuel import costs incurred by power plants compared to the reference generation benchmark.'
  },
  {
    question: 'Does K-Electric use the same tariff as LESCO or IESCO?',
    answer: 'Yes. Under the government\'s uniform national tariff policy, basic residential consumer slabs and GST/ED rules are aligned across all DISCOs and K-Electric.'
  },
  {
    question: 'Why does crossing 200 units cause a sudden jump in the bill?',
    answer: 'Crossing 200 units loses protected consumer status and triggers 18% General Sales Tax (GST) across the entire bill, causing a disproportionate total cost surge.'
  }
];

const webAppSchema = generateWebApplicationJsonLd({
  name: 'Pakistan Electricity Bill Calculator (All DISCOs) — Count Loft',
  description: 'Calculate residential electricity bills for LESCO, IESCO, K-Electric, FESCO, MEPCO with uniform NEPRA slabs, FPA, and GST.',
  url: 'https://count-loft.com/pakistan/electricity-bill-calculator',
  category: 'WebApplication'
});
---

<ToolShell
  title="Pakistan Electricity Bill Calculator (All DISCOs)"
  description="Estimate residential electricity bills for LESCO, IESCO, K-Electric, and all DISCOs using official NEPRA uniform tariffs, FPA surcharges, and taxes."
  category="pakistan"
  breadcrumbs={breadcrumbs}
  author="Count Loft Team"
  lastUpdated="2026-10-31"
>
  <div slot="inputs">
    <div class="data-badge-notice">
      Official Source: {tariffData.source} • Verified: {tariffData.lastVerified}
    </div>

    <form id="elec-form" novalidate onsubmit="return false;">
      <div class="form-row-2">
        <div class="form-group">
          <label for="elec-disco" class="form-label">Electricity Company (DISCO)</label>
          <select id="elec-disco" class="form-input">
            {tariffData.discos.map(d => (
              <option value={d.id}>{d.name}</option>
            ))}
          </select>
        </div>
        <div class="form-group">
          <label for="elec-units" class="form-label">Units Consumed (kWh)</label>
          <input type="number" id="elec-units" class="form-input" value="300" min="1" max="5000" />
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label for="elec-fpa" class="form-label">Estimated FPA (Rs / Unit)</label>
          <input type="number" id="elec-fpa" class="form-input" value="3.50" step="0.25" />
        </div>
        <div class="form-group">
          <label for="elec-protected" class="form-label">Consumer Category</label>
          <select id="elec-protected" class="form-input">
            <option value="false" selected>Unprotected (Standard)</option>
            <option value="true">Protected (Under 200 units for 6 months)</option>
          </select>
        </div>
      </div>
    </form>
  </div>

  <div slot="results">
    <div class="result-hero">
      <span class="result-hero-label">Estimated Total Electricity Bill</span>
      <span class="result-hero-value" id="elec-total-val">Rs 11,885</span>
      <span class="result-hero-subtext" id="elec-rate-val">Effective Rate: Rs 39.62 per unit</span>
    </div>

    <div class="elec-breakdown-table">
      <div class="breakdown-row">
        <span>Base Energy Cost (NEPRA Slabs):</span>
        <strong id="elec-base-val">Rs 6,657</strong>
      </div>
      <div class="breakdown-row">
        <span>Fuel Price Adjustment (FPA):</span>
        <strong id="elec-fpa-val">Rs 1,050</strong>
      </div>
      <div class="breakdown-row">
        <span>Electricity Duty (1.5%):</span>
        <strong id="elec-duty-val">Rs 116</strong>
      </div>
      <div class="breakdown-row">
        <span>General Sales Tax (18% GST):</span>
        <strong id="elec-gst-val">Rs 1,403</strong>
      </div>
      <div class="breakdown-row">
        <span>PTV Fee:</span>
        <strong id="elec-tv-val">Rs 35</strong>
      </div>
    </div>
  </div>

  <div slot="how-to">
    <ol>
      <li><strong>Select your power distribution company:</strong> Choose LESCO, IESCO, K-Electric, etc.</li>
      <li><strong>Enter monthly units:</strong> Record the total kWh units indicated on your meter reading.</li>
      <li><strong>Inspect cost drivers:</strong> View how slab rates, fuel adjustment surcharges, and sales taxes contribute to the final bill.</li>
    </ol>
  </div>

  <div slot="formula">
    <pre><code>Base Energy Cost   = Σ (Units in Slab × Slab Rate)
FPA Surcharge      = Units × FPA per unit
Electricity Duty   = (Base Energy + FPA) × 1.5%
GST (Units > 200)  = (Base Energy + FPA + Duty) × 18%
Total Bill         = Base Energy + FPA + Duty + GST + TV Fee (Rs. 35)</code></pre>
  </div>

  <div slot="examples-table">
    <table class="data-table">
      <thead>
        <tr>
          <th>Monthly Units</th>
          <th>Status</th>
          <th>Base Energy</th>
          <th>Taxes & FPA</th>
          <th>Estimated Bill</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>50 Units</td><td>Protected</td><td>Rs 198</td><td>Rs 213</td><td>Rs 411</td></tr>
        <tr><td>100 Units</td><td>Protected</td><td>Rs 585</td><td>Rs 394</td><td>Rs 979</td></tr>
        <tr><td>200 Units</td><td>Unprotected</td><td>Rs 3,943</td><td>Rs 795</td><td>Rs 4,738</td></tr>
        <tr><td>300 Units</td><td>Unprotected</td><td>Rs 6,657</td><td>Rs 2,569</td><td>Rs 9,226</td></tr>
        <tr><td>500 Units</td><td>Unprotected</td><td>Rs 13,384</td><td>Rs 4,510</td><td>Rs 17,894</td></tr>
      </tbody>
    </table>
  </div>

  <div slot="faq">
    <FaqAccordion items={faqs} />
  </div>

  <div slot="related-tools">
    <div class="related-tools-grid">
      <a href="/pakistan/income-tax-calculator" class="card related-tool-card">
        <h3>Pakistan Income Tax Calculator</h3>
        <p>Calculate monthly FBR salary deductions and net pay.</p>
      </a>
      <a href="/pakistan/ac-tonnage-calculator" class="card related-tool-card">
        <h3>AC Tonnage Calculator</h3>
        <p>Size air conditioners accurately to prevent excessive power consumption.</p>
      </a>
    </div>
  </div>
</ToolShell>

<JsonLd schema={[webAppSchema, generateFaqJsonLd(faqs), generateBreadcrumbJsonLd([{ name: 'Home', item: '/' }, { name: 'Pakistan', item: '/pakistan' }, { name: 'Electricity Bill Calculator', item: '/pakistan/electricity-bill-calculator' }])]} />

<style>
  .data-badge-notice {
    font-size: var(--text-xs);
    background-color: var(--color-bg-subtle);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-4);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .elec-breakdown-table {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
  }
</style>

<script>
  import { calculatePkElectricity } from '@lib/calc/pk-electricity';
  import { parseNumberInput } from '@lib/format/number';

  function initElectricity() {
    const discoIn = document.getElementById('elec-disco') as HTMLSelectElement | null;
    const unitsIn = document.getElementById('elec-units') as HTMLInputElement | null;
    const fpaIn = document.getElementById('elec-fpa') as HTMLInputElement | null;
    const protectedIn = document.getElementById('elec-protected') as HTMLSelectElement | null;

    const totalDisplay = document.getElementById('elec-total-val');
    const rateDisplay = document.getElementById('elec-rate-val');
    const baseDisplay = document.getElementById('elec-base-val');
    const fpaDisplay = document.getElementById('elec-fpa-val');
    const dutyDisplay = document.getElementById('elec-duty-val');
    const gstDisplay = document.getElementById('elec-gst-val');
    const tvDisplay = document.getElementById('elec-tv-val');

    function formatPkr(val: number): string {
      return `Rs ${Math.round(val).toLocaleString()}`;
    }

    function update() {
      const discoId = discoIn?.value || 'lesco';
      const units = parseNumberInput(unitsIn?.value, 300);
      const fpaPerUnit = parseNumberInput(fpaIn?.value, 3.5);
      const isProtected = protectedIn?.value === 'true';

      const res = calculatePkElectricity({
        units,
        isProtected,
        fpaPerUnit,
        discoId
      });

      if (totalDisplay) totalDisplay.textContent = formatPkr(res.totalBill);
      if (rateDisplay) rateDisplay.textContent = `Effective Rate: Rs ${res.effectiveRatePerUnit} per unit (${res.discoName})`;
      if (baseDisplay) baseDisplay.textContent = formatPkr(res.baseEnergyCost);
      if (fpaDisplay) fpaDisplay.textContent = formatPkr(res.fpaCost);
      if (dutyDisplay) dutyDisplay.textContent = formatPkr(res.electricityDuty);
      if (gstDisplay) gstDisplay.textContent = formatPkr(res.gst);
      if (tvDisplay) tvDisplay.textContent = formatPkr(res.tvFee);
    }

    [discoIn, unitsIn, fpaIn, protectedIn].forEach(i => {
      i?.addEventListener('input', update);
      i?.addEventListener('change', update);
    });
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initElectricity);
  } else {
    initElectricity();
  }
</script>
